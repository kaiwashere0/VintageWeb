<!-- MINIMALIST NAVBAR (Fluid Responsive Layout & Smooth Capsule Floating) -->
<header id="main-navbar" class="w-full sticky top-0 z-50">
  <div class="nav-container flex items-center justify-between">
    
    <!-- Brand Logo & Clean Name -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
      <img src="/Wintage_Club_Logo_2050.png" alt="Vintage Club Logo" class="h-9 sm:h-10 w-auto object-contain transition-transform group-hover:scale-105" />
      <span class="font-heading text-base sm:text-lg font-bold tracking-tight text-[#4A2B1D] dark:text-white whitespace-nowrap">
        Vintage Club
      </span>
    </a>

    <!-- Center Navigation Links (Hidden below lg, clean and spacious) -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
      <a href="/" class="nav-link-item <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">
        Home
      </a>
      <a href="/about" class="nav-link-item <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">
        About Us
      </a>
      <a href="/events" class="nav-link-item <%= (typeof currentPath !== 'undefined' && currentPath === '/events') ? 'active' : '' %>">
        Events
      </a>
      <a href="/apply" class="nav-link-item <%= (typeof currentPath !== 'undefined' && currentPath === '/apply') ? 'active' : '' %>">
        Apply
      </a>
    </nav>

    <!-- Right Controls: Theme Toggle, Auth & CTA -->
    <div class="hidden lg:flex items-center gap-2">
      <!-- Theme Toggle Button -->
      <button type="button" class="theme-toggle-btn w-8 h-8 rounded-lg text-[#8C5137] dark:text-[#E1E2E4] hover:text-[#4A2B1D] dark:hover:text-white hover:bg-[#E1E2E4]/50 dark:hover:bg-[#18100B] transition-colors flex items-center justify-center flex-shrink-0" title="Toggle Theme" aria-label="Toggle Theme">
        <i class="fa-solid fa-moon dark:hidden text-xs"></i>
        <i class="fa-solid fa-sun hidden dark:block text-[#AA6343] text-xs"></i>
      </button>

      <!-- Authentication Button / User Profile -->
      <% if (typeof user !== 'undefined' && user) { %>
        <!-- Logged In Dropdown -->
        <div class="relative group flex-shrink-0">
          <button type="button" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-white/80 dark:bg-[#18100B] border border-[#E1E2E4] dark:border-[#4A2B1D] text-xs font-semibold text-[#4A2B1D] dark:text-white hover:border-[#8C5137] transition-all shadow-xs">
            <img src="<%= user.avatarUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" alt="<%= user.username %>" class="w-5 h-5 rounded-full object-cover border border-[#8C5137]/50" />
            <span class="max-w-[90px] truncate"><%= user.globalName || user.username %></span>
            <i class="fa-solid fa-chevron-down text-[10px] text-[#8C5137]"></i>
          </button>
          <div class="absolute right-0 mt-1 w-48 bg-white dark:bg-[#18100B] border border-[#E1E2E4] dark:border-[#4A2B1D] rounded-xl p-2 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <div class="px-2.5 py-1.5 border-b border-[#E1E2E4] dark:border-[#4A2B1D] mb-1">
              <span class="block text-xs font-bold text-[#4A2B1D] dark:text-white truncate"><%= user.globalName || user.username %></span>
              <span class="text-[10px] text-[#8C5137] dark:text-[#AA6343] font-medium">@<%= user.username %></span>
            </div>
            <% if (user.isSuperAdmin) { %>
              <a href="/admin" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition-colors mb-1">
                <i class="fa-solid fa-crown text-xs"></i>
                <span>Yetkili Paneli</span>
              </a>
            <% } %>
            <a href="/auth/logout" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors">
              <i class="fa-solid fa-right-from-bracket text-xs"></i>
              <span>Log Out</span>
            </a>
          </div>
        </div>
      <% } else { %>
        <!-- Login Modal Trigger Button -->
        <button type="button" class="open-login-modal-btn px-3 py-1.5 rounded-lg border border-[#E1E2E4] dark:border-[#4A2B1D] bg-white/60 dark:bg-[#18100B] hover:bg-white dark:hover:bg-[#20130C] text-xs font-semibold text-[#4A2B1D] dark:text-[#E1E2E4] hover:text-[#8C5137] dark:hover:text-[#AA6343] hover:border-[#8C5137] transition-all flex items-center gap-1.5 shadow-xs flex-shrink-0 cursor-pointer">
          <i class="fa-solid fa-arrow-right-to-bracket text-[#8C5137] dark:text-[#AA6343] text-xs"></i>
          <span>Giriş Yap</span>
        </button>
      <% } %>

      <a href="/apply" class="px-3.5 py-1.5 btn-primary text-xs font-semibold rounded-lg gap-1.5 shadow-xs flex-shrink-0">
        <span>Join Us</span>
      </a>
    </div>

    <!-- Mobile Controls (Active below lg) -->
    <div class="flex lg:hidden items-center gap-2">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/auth/logout" class="w-8 h-8 rounded-lg text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center justify-center" title="Log Out">
          <i class="fa-solid fa-right-from-bracket text-xs"></i>
        </a>
      <% } else { %>
        <button type="button" class="open-login-modal-btn w-8 h-8 rounded-lg text-[#4A2B1D] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/50 dark:hover:bg-[#18100B] flex items-center justify-center cursor-pointer" aria-label="Giriş Yap">
          <i class="fa-solid fa-arrow-right-to-bracket text-[#8C5137] dark:text-[#AA6343] text-sm"></i>
        </button>
      <% } %>

      <button type="button" class="theme-toggle-btn w-8 h-8 rounded-lg text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/50 dark:hover:bg-[#18100B] flex items-center justify-center" aria-label="Toggle Theme">
        <i class="fa-solid fa-moon dark:hidden text-xs"></i>
        <i class="fa-solid fa-sun hidden dark:block text-[#AA6343] text-xs"></i>
      </button>

      <button id="mobile-menu-btn" class="w-8 h-8 rounded-lg text-[#4A2B1D] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/50 dark:hover:bg-[#18100B] flex items-center justify-center" aria-label="Menu">
        <i class="fa-solid fa-bars text-sm"></i>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden max-w-7xl mx-auto px-4 pb-4">
    <div class="bg-white/95 dark:bg-[#18100B]/95 backdrop-blur-md border border-[#E1E2E4] dark:border-[#4A2B1D] rounded-xl p-3 space-y-1 shadow-lg">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="px-3 py-2 bg-[#E1E2E4]/40 dark:bg-[#20130C] rounded-lg flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <img src="<%= user.avatarUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" class="w-6 h-6 rounded-full object-cover" />
            <span class="text-xs font-bold text-[#4A2B1D] dark:text-white"><%= user.globalName || user.username %></span>
          </div>
          <a href="/auth/logout" class="text-xs text-rose-500 font-semibold">Log Out</a>
        </div>
        <% if (user.isSuperAdmin) { %>
          <a href="/admin" class="block px-3 py-2 rounded-lg text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 mb-1">
            <i class="fa-solid fa-crown mr-1"></i> Yetkili Paneli
          </a>
        <% } %>
      <% } else { %>
        <button type="button" class="open-login-modal-btn w-full text-left px-3 py-2 rounded-lg text-xs font-semibold text-[#8C5137] dark:text-[#AA6343] hover:bg-[#E1E2E4]/40 dark:hover:bg-[#20130C] flex items-center gap-2 cursor-pointer">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Giriş Yap
        </button>
      <% } %>

      <a href="/" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-[#E1E2E4]/60 dark:bg-[#20130C] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/30 dark:hover:bg-[#20130C]/50' %>">
        Home
      </a>
      <a href="/about" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'bg-[#E1E2E4]/60 dark:bg-[#20130C] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/30 dark:hover:bg-[#20130C]/50' %>">
        About Us
      </a>
      <a href="/events" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/events') ? 'bg-[#E1E2E4]/60 dark:bg-[#20130C] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/30 dark:hover:bg-[#20130C]/50' %>">
        Events
      </a>
      <a href="/apply" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/apply') ? 'bg-[#E1E2E4]/60 dark:bg-[#20130C] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/30 dark:hover:bg-[#20130C]/50' %>">
        Driver Application
      </a>
      <div class="pt-2 border-t border-[#E1E2E4] dark:border-[#4A2B1D] flex flex-col gap-1.5">
        <a href="/apply" class="w-full py-2 btn-primary text-center text-xs font-semibold rounded-lg">
          Join Us
        </a>
      </div>
    </div>
  </div>

  <!-- AUTH & LOGIN MODAL -->
  <%- include('login-modal') %>
</header>
