<!-- MINIMALIST NAVBAR (Fluid Responsive Layout & Ultra Clean Spacing) -->
<header id="main-navbar" class="w-full sticky top-0 z-50">
  <div class="nav-container flex items-center justify-between py-2 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Brand Logo & Clean Name -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
      <img src="/Wintage_Club_Logo_2050.png" alt="Vintage Club Logo" class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105" />
      <span class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[#4A2B1D] dark:text-white whitespace-nowrap">
        Vintage Club
      </span>
    </a>

    <!-- Center Navigation Links (Clean & Spacious) -->
    <nav class="hidden md:flex items-center gap-1.5 lg:gap-3">
      <a href="/" class="nav-link-item px-3 py-1.5 rounded-lg text-xs font-semibold text-[#4A2B1D] dark:text-slate-200 hover:text-[#8C5137] dark:hover:text-[#D48D66] hover:bg-[#E1E2E4]/40 dark:hover:bg-[#181B24] transition-all <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-[#8C5137]/10 dark:bg-[#AA6343]/20 text-[#8C5137] dark:text-[#AA6343] font-bold' : '' %>">
        <%= t('nav.home', 'Home') %>
      </a>
      <a href="/about" class="nav-link-item px-3 py-1.5 rounded-lg text-xs font-semibold text-[#4A2B1D] dark:text-slate-200 hover:text-[#8C5137] dark:hover:text-[#D48D66] hover:bg-[#E1E2E4]/40 dark:hover:bg-[#181B24] transition-all <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'bg-[#8C5137]/10 dark:bg-[#AA6343]/20 text-[#8C5137] dark:text-[#AA6343] font-bold' : '' %>">
        <%= t('nav.about', 'About') %>
      </a>
      <a href="/events" class="nav-link-item px-3 py-1.5 rounded-lg text-xs font-semibold text-[#4A2B1D] dark:text-slate-200 hover:text-[#8C5137] dark:hover:text-[#D48D66] hover:bg-[#E1E2E4]/40 dark:hover:bg-[#181B24] transition-all <%= (typeof currentPath !== 'undefined' && currentPath === '/events') ? 'bg-[#8C5137]/10 dark:bg-[#AA6343]/20 text-[#8C5137] dark:text-[#AA6343] font-bold' : '' %>">
        <%= t('nav.events', 'Events') %>
      </a>
      <a href="/apply" class="nav-link-item px-3 py-1.5 rounded-lg text-xs font-semibold text-[#4A2B1D] dark:text-slate-200 hover:text-[#8C5137] dark:hover:text-[#D48D66] hover:bg-[#E1E2E4]/40 dark:hover:bg-[#181B24] transition-all <%= (typeof currentPath !== 'undefined' && currentPath === '/apply') ? 'bg-[#8C5137]/10 dark:bg-[#AA6343]/20 text-[#8C5137] dark:text-[#AA6343] font-bold' : '' %>">
        <%= t('nav.apply', 'Apply') %>
      </a>
    </nav>

    <!-- Right Controls: Language Selector Capsule, Theme & Auth -->
    <div class="flex items-center gap-2">
      
      <!-- DESKTOP / TABLET COMPACT LANGUAGE DROPDOWN -->
      <div class="relative group flex-shrink-0">
        <button type="button" class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white/70 dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] text-xs font-semibold text-[#4A2B1D] dark:text-white hover:border-[#8C5137] dark:hover:border-[#D48D66] transition-all shadow-xs cursor-pointer" title="<%= t('nav.select_language', 'Language') %>">
          <span class="text-xs leading-none"><%= (typeof currentLangObj !== 'undefined' && currentLangObj) ? currentLangObj.flag : '🇬🇧' %></span>
          <span class="text-[11px] font-bold tracking-wider"><%= (typeof currentLangObj !== 'undefined' && currentLangObj) ? currentLangObj.label : 'EN' %></span>
          <i class="fa-solid fa-chevron-down text-[9px] text-[#8C5137] dark:text-[#D48D66] transition-transform group-hover:rotate-180"></i>
        </button>
        <div class="absolute right-0 mt-1 w-32 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl p-1 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
          <% (typeof availableLanguages !== 'undefined' ? availableLanguages : []).forEach(function(lang) { %>
            <a href="/lang/<%= lang.code %>" class="flex items-center justify-between px-2 py-1.5 rounded-lg text-xs font-medium <%= (typeof currentLang !== 'undefined' && currentLang === lang.code) ? 'bg-[#8C5137]/10 dark:bg-[#AA6343]/20 text-[#8C5137] dark:text-[#AA6343] font-bold' : 'text-[#4A2B1D] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#202430]' %> transition-colors">
              <span class="flex items-center gap-1.5">
                <span><%= lang.flag %></span>
                <span><%= lang.name %></span>
              </span>
              <% if (typeof currentLang !== 'undefined' && currentLang === lang.code) { %>
                <i class="fa-solid fa-check text-[9px]"></i>
              <% } %>
            </a>
          <% }); %>
        </div>
      </div>

      <!-- Theme Toggle Button -->
      <button type="button" class="theme-toggle-btn w-8 h-8 rounded-lg text-[#8C5137] dark:text-slate-300 hover:text-[#4A2B1D] dark:hover:text-white hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] transition-colors flex items-center justify-center flex-shrink-0 cursor-pointer" title="Toggle Theme" aria-label="Toggle Theme">
        <i class="fa-solid fa-moon dark:hidden text-xs"></i>
        <i class="fa-solid fa-sun hidden dark:block text-[#D48D66] text-xs"></i>
      </button>

      <!-- Authentication Button / User Profile -->
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="relative group flex-shrink-0">
          <button type="button" class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white/80 dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] text-xs font-semibold text-[#4A2B1D] dark:text-white hover:border-[#8C5137] dark:hover:border-[#D48D66] transition-all shadow-xs cursor-pointer">
            <img src="<%= user.avatarUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" alt="<%= user.username %>" class="w-5 h-5 rounded-full object-cover border border-[#8C5137]/50" />
            <span class="hidden sm:inline max-w-[80px] truncate"><%= user.globalName || user.username %></span>
            <i class="fa-solid fa-chevron-down text-[9px] text-[#8C5137] dark:text-[#D48D66]"></i>
          </button>
          <div class="absolute right-0 mt-1 w-44 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl p-1.5 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <div class="px-2 py-1 border-b border-[#E1E2E4] dark:border-[#262A36] mb-1">
              <span class="block text-xs font-bold text-[#4A2B1D] dark:text-white truncate"><%= user.globalName || user.username %></span>
              <span class="text-[10px] text-[#8C5137] dark:text-[#D48D66] font-medium">@<%= user.username %></span>
            </div>
            <% if (user.isDeveloper) { %>
              <a href="/developer" class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-colors mb-1">
                <i class="fa-solid fa-terminal text-xs"></i>
                <span>Developer Portal</span>
              </a>
            <% } %>
            <% if (user.isSuperAdmin) { %>
              <a href="/admin" class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs font-semibold text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition-colors mb-1">
                <i class="fa-solid fa-crown text-xs"></i>
                <span><%= t('nav.admin', 'Admin Portal') %></span>
              </a>
            <% } %>
            <a href="/auth/logout" class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors">
              <i class="fa-solid fa-right-from-bracket text-xs"></i>
              <span><%= t('nav.logout', 'Log Out') %></span>
            </a>
          </div>
        </div>
      <% } else { %>
        <button type="button" class="open-login-modal-btn hidden sm:flex px-2.5 py-1.5 rounded-lg border border-[#E1E2E4] dark:border-[#262A36] bg-white/60 dark:bg-[#181B24] hover:bg-white dark:hover:bg-[#202430] text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 hover:text-[#8C5137] dark:hover:text-[#D48D66] hover:border-[#8C5137] dark:hover:border-[#D48D66] transition-all items-center gap-1.5 shadow-xs flex-shrink-0 cursor-pointer">
          <i class="fa-solid fa-arrow-right-to-bracket text-[#8C5137] dark:text-[#D48D66] text-xs"></i>
          <span><%= t('nav.login', 'Sign In') %></span>
        </button>
      <% } %>

      <!-- CTA Join Button -->
      <a href="/apply" class="hidden sm:inline-flex px-3 py-1.5 btn-primary text-xs font-semibold rounded-lg shadow-xs flex-shrink-0">
        <span><%= t('hero.btn_apply', 'Join Us') %></span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-btn" class="md:hidden w-8 h-8 rounded-lg text-[#4A2B1D] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] flex items-center justify-center cursor-pointer" aria-label="Menu">
        <i class="fa-solid fa-bars text-sm"></i>
      </button>

    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden max-w-7xl mx-auto px-4 pb-4">
    <div class="bg-white/95 dark:bg-[#181B24]/95 backdrop-blur-md border border-[#E1E2E4] dark:border-[#262A36] rounded-xl p-3 space-y-1 shadow-lg">
      
      <!-- Mobile Language Selection Full Bar -->
      <div class="p-2 mb-2 bg-[#E1E2E4]/30 dark:bg-[#202430] rounded-lg">
        <span class="block text-[10px] uppercase font-bold text-[#8C5137] dark:text-[#D48D66] mb-1.5"><%= t('nav.select_language', 'Language') %></span>
        <div class="grid grid-cols-3 gap-1.5">
          <% (typeof availableLanguages !== 'undefined' ? availableLanguages : []).forEach(function(lang) { %>
            <a href="/lang/<%= lang.code %>" class="flex items-center justify-center gap-1.5 py-1.5 rounded-md text-xs font-semibold <%= (typeof currentLang !== 'undefined' && currentLang === lang.code) ? 'bg-[#8C5137] text-white shadow-xs' : 'bg-white/80 dark:bg-[#181B24] text-[#4A2B1D] dark:text-slate-300' %> transition-all">
              <span><%= lang.flag %></span>
              <span><%= lang.label %></span>
            </a>
          <% }); %>
        </div>
      </div>

      <% if (typeof user !== 'undefined' && user) { %>
        <div class="px-3 py-2 bg-[#E1E2E4]/40 dark:bg-[#202430] rounded-lg flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <img src="<%= user.avatarUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" class="w-6 h-6 rounded-full object-cover" />
            <span class="text-xs font-bold text-[#4A2B1D] dark:text-white"><%= user.globalName || user.username %></span>
          </div>
          <a href="/auth/logout" class="text-xs text-rose-500 font-semibold"><%= t('nav.logout', 'Log Out') %></a>
        </div>
        <% if (user.isDeveloper) { %>
          <a href="/developer" class="block px-3 py-2 rounded-lg text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 mb-1">
            <i class="fa-solid fa-terminal mr-1"></i> Developer Portal
          </a>
        <% } %>
        <% if (user.isSuperAdmin) { %>
          <a href="/admin" class="block px-3 py-2 rounded-lg text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 mb-1">
            <i class="fa-solid fa-crown mr-1"></i> <%= t('nav.admin', 'Admin Portal') %>
          </a>
        <% } %>
      <% } else { %>
        <button type="button" class="open-login-modal-btn w-full text-left px-3 py-2 rounded-lg text-xs font-semibold text-[#8C5137] dark:text-[#D48D66] hover:bg-[#E1E2E4]/40 dark:hover:bg-[#202430] flex items-center gap-2 cursor-pointer mb-1">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> <%= t('nav.login', 'Sign In') %>
        </button>
      <% } %>

      <a href="/" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-[#E1E2E4]/60 dark:bg-[#202430] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/30 dark:hover:bg-[#202430]/50' %>">
        <%= t('nav.home', 'Home') %>
      </a>
      <a href="/about" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'bg-[#E1E2E4]/60 dark:bg-[#202430] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/30 dark:hover:bg-[#202430]/50' %>">
        <%= t('nav.about', 'About') %>
      </a>
      <a href="/events" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/events') ? 'bg-[#E1E2E4]/60 dark:bg-[#202430] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/30 dark:hover:bg-[#202430]/50' %>">
        <%= t('nav.events', 'Events') %>
      </a>
      <a href="/apply" class="block px-3 py-2 rounded-lg text-xs font-medium <%= (typeof currentPath !== 'undefined' && currentPath === '/apply') ? 'bg-[#E1E2E4]/60 dark:bg-[#202430] text-[#4A2B1D] dark:text-white font-bold' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/30 dark:hover:bg-[#202430]/50' %>">
        <%= t('nav.apply', 'Driver Application') %>
      </a>
      <div class="pt-2 border-t border-[#E1E2E4] dark:border-[#262A36] flex flex-col gap-1.5">
        <a href="/apply" class="w-full py-2 btn-primary text-center text-xs font-semibold rounded-lg">
          <%= t('hero.btn_apply', 'Join Us') %>
        </a>
      </div>
    </div>
  </div>

  <!-- AUTH & LOGIN MODAL -->
  <%- include('login-modal') %>
</header>
