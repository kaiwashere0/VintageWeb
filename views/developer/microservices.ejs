<!DOCTYPE html>
<html lang="en" class="h-full bg-[#08090C] text-slate-100">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Microservices Management — Vintage Club" %></title>
  <link rel="stylesheet" href="/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
</head>

<body class="min-h-full flex bg-[#08090C] text-slate-100 antialiased selection:bg-[#8C5137] selection:text-white font-sans">

  <!-- DEVELOPER SIDEBAR -->
  <%- include('partials/sidebar', { currentPath: '/developer/microservices' }) %>

  <!-- MAIN DEVELOPER WORKSPACE -->
  <div class="flex-1 flex flex-col min-w-0 lg:pl-64">
    
    <!-- TOP HEADER -->
    <%- include('partials/header', { 
      pageTitle: "Microservice Controller", 
      pageSubtitle: 'Real-time uptime, error tracking, active endpoints and service health' 
    }) %>

    <main class="p-4 sm:p-8 space-y-8 flex-1">

      <!-- SECTION: ALL 5 SYSTEM MICROSERVICES -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#D48D66]">Architecture Breakdown</span>
            <h2 class="text-xl font-bold text-white font-heading mt-0.5">Active Microservices (5)</h2>
          </div>
          <button id="ping-all-btn" class="px-3 py-1.5 rounded-xl bg-[#151922] border border-[#1E232E] text-xs font-mono text-slate-300 hover:text-white flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-satellite-dish text-[#D48D66]"></i>
            <span>Health Ping All</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          
          <!-- 1. Database Microservice -->
          <div class="p-5 rounded-2xl bg-[#0F1219] border border-[#1E232E] flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-database"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold text-white font-sans"><%= microservices.database.name %></h3>
                    <span class="text-[10px] font-mono text-slate-400"><%= microservices.database.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400">
                  <%= microservices.database.status.toUpperCase() %>
                </span>
              </div>

              <div class="p-3 rounded-xl bg-[#151922] font-mono text-[11px] space-y-1.5 text-slate-300">
                <div class="flex justify-between">
                  <span class="text-slate-500">Connection:</span>
                  <span class="text-white"><%= microservices.database.state %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Host / Port:</span>
                  <span class="text-slate-200"><%= microservices.database.host %>:<%= microservices.database.port %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Database Name:</span>
                  <span class="text-emerald-400"><%= microservices.database.dbName %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Active Models:</span>
                  <span class="text-white"><%= microservices.database.modelsCount %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Ping Latency:</span>
                  <span class="text-[#D48D66] font-bold"><%= microservices.database.latencyMs %> ms</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 pt-2 border-t border-[#1E232E]">
              <span>Uptime: <%= Math.floor(microservices.database.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-400 font-bold">Auto-Start Enabled</span>
            </div>
          </div>

          <!-- 2. TruckersMP Web API Microservice -->
          <div class="p-5 rounded-2xl bg-[#0F1219] border border-[#1E232E] flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-[#8C5137]/20 border border-[#8C5137]/40 text-[#D48D66] flex items-center justify-center text-xs">
                    <i class="fa-solid fa-truck-fast"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold text-white font-sans"><%= microservices.truckersmp.name %></h3>
                    <span class="text-[10px] font-mono text-slate-400"><%= microservices.truckersmp.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400">
                  HEALTHY
                </span>
              </div>

              <div class="p-3 rounded-xl bg-[#151922] font-mono text-[11px] space-y-1.5 text-slate-300">
                <div class="flex justify-between">
                  <span class="text-slate-500">Specification:</span>
                  <span class="text-white">OpenAPI 3.1 (v2.0)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Active Routes:</span>
                  <span class="text-sky-400 font-bold"><%= microservices.truckersmp.activeRoutes.length %> Endpoints</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Caching Engine:</span>
                  <span class="text-emerald-400">In-Memory TTL Buffer</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Upstream Base:</span>
                  <span class="text-slate-400 truncate max-w-[140px]"><%= microservices.truckersmp.baseUrl %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Upstream Ping:</span>
                  <span class="text-[#D48D66] font-bold"><%= microservices.truckersmp.latencyMs >= 0 ? `${microservices.truckersmp.latencyMs} ms` : 'Standby' %></span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 pt-2 border-t border-[#1E232E]">
              <a href="/developer/truckersmp" class="text-[#D48D66] hover:underline font-bold">Open API Sandbox &rarr;</a>
              <span>Uptime: <%= Math.floor(microservices.truckersmp.uptimeSeconds / 60) %> mins</span>
            </div>
          </div>

          <!-- 3. Discord Bot Gateway Microservice -->
          <div class="p-5 rounded-2xl bg-[#0F1219] border border-[#1E232E] flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs">
                    <i class="fa-brands fa-discord"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold text-white font-sans"><%= microservices.discordBot.name %></h3>
                    <span class="text-[10px] font-mono text-slate-400"><%= microservices.discordBot.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-500/20 text-indigo-400">
                  <%= microservices.discordBot.status.toUpperCase() %>
                </span>
              </div>

              <div class="p-3 rounded-xl bg-[#151922] font-mono text-[11px] space-y-1.5 text-slate-300">
                <div class="flex justify-between">
                  <span class="text-slate-500">Bot Tag:</span>
                  <span class="text-white font-bold"><%= microservices.discordBot.tag %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Gateway WS Ping:</span>
                  <span class="text-indigo-300"><%= microservices.discordBot.pingMs %> ms</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Connected Guilds:</span>
                  <span class="text-white"><%= microservices.discordBot.guildsCount %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Protocol:</span>
                  <span class="text-slate-300">Discord API v10 WS</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 pt-2 border-t border-[#1E232E]">
              <span>Uptime: <%= Math.floor(microservices.discordBot.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-400">Standby Ready</span>
            </div>
          </div>

          <!-- 4. Auth & Security Microservice -->
          <div class="p-5 rounded-2xl bg-[#0F1219] border border-[#1E232E] flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-lock"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold text-white font-sans"><%= microservices.auth.name %></h3>
                    <span class="text-[10px] font-mono text-slate-400"><%= microservices.auth.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/20 text-amber-400">
                  SECURE
                </span>
              </div>

              <div class="p-3 rounded-xl bg-[#151922] font-mono text-[11px] space-y-1.5 text-slate-300">
                <div class="flex justify-between">
                  <span class="text-slate-500">OAuth Provider:</span>
                  <span class="text-white"><%= microservices.auth.provider %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Secret Encryption:</span>
                  <span class="text-emerald-400"><%= microservices.auth.secretConfigured ? 'SHA-256 HMAC Active' : 'Missing' %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Super Admins:</span>
                  <span class="text-white"><%= microservices.auth.superAdminsConfigured %> configured</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Developers:</span>
                  <span class="text-[#D48D66] font-bold"><%= microservices.auth.developersConfigured %> authorized</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 pt-2 border-t border-[#1E232E]">
              <span>Uptime: <%= Math.floor(microservices.auth.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-400">Session Guard Active</span>
            </div>
          </div>

          <!-- 5. i18n Localization Microservice -->
          <div class="p-5 rounded-2xl bg-[#0F1219] border border-[#1E232E] flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-teal-500/10 border border-teal-500/20 text-teal-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-language"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold text-white font-sans"><%= microservices.i18n.name %></h3>
                    <span class="text-[10px] font-mono text-slate-400"><%= microservices.i18n.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-teal-500/20 text-teal-400">
                  LOADED
                </span>
              </div>

              <div class="p-3 rounded-xl bg-[#151922] font-mono text-[11px] space-y-1.5 text-slate-300">
                <div class="flex justify-between">
                  <span class="text-slate-500">Languages:</span>
                  <span class="text-white font-bold"><%= microservices.i18n.languages.map(l => l.toUpperCase()).join(' / ') %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Default Locale:</span>
                  <span class="text-teal-300 font-bold"><%= microservices.i18n.defaultLang.toUpperCase() %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">IP Geolocation:</span>
                  <span class="text-emerald-400"><%= microservices.i18n.geoDetection %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">TR/EN/DE Keys:</span>
                  <span class="text-slate-200"><%= Object.values(microservices.i18n.keyCounts).join(' / ') %> keys</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 pt-2 border-t border-[#1E232E]">
              <span>Uptime: <%= Math.floor(microservices.i18n.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-400">Dynamic Switch Active</span>
            </div>
          </div>

        </div>
      </div>

      <!-- SECTION: MICROSERVICE ERROR LOGS TELEMETRY -->
      <div class="p-6 rounded-2xl bg-[#0F1219] border border-[#1E232E]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 pb-3 border-b border-[#1E232E]">
          <div>
            <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-amber-400">Live Telemetry</span>
            <h2 class="text-base font-bold text-white font-sans mt-0.5">Service Error Logs & Stack Traces</h2>
          </div>
          <button id="clear-error-logs-btn" class="px-3 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 hover:bg-rose-500/20 text-xs font-mono flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-trash text-[10px]"></i>
            <span>Clear Error Buffer</span>
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs">
            <thead>
              <tr class="text-slate-500 border-b border-[#1E232E] text-[11px]">
                <th class="py-2.5 px-3">TIMESTAMP</th>
                <th class="py-2.5 px-3">LEVEL</th>
                <th class="py-2.5 px-3">MICROSERVICE</th>
                <th class="py-2.5 px-3">ERROR MESSAGE / STACK</th>
              </tr>
            </thead>
            <tbody id="telemetry-errors-table-body">
              <% if (!errorLogs || errorLogs.length === 0) { %>
                <tr>
                  <td colspan="4" class="py-8 text-center text-xs text-emerald-400 font-mono">
                    <i class="fa-solid fa-circle-check mr-1.5"></i> Zero microservice errors recorded. All systems running optimally.
                  </td>
                </tr>
              <% } else { %>
                <% errorLogs.forEach(function(e) { %>
                  <tr class="border-b border-[#1E232E] hover:bg-[#151922] transition-colors">
                    <td class="py-2.5 px-3 text-slate-400"><%= new Date(e.time).toLocaleTimeString() %></td>
                    <td class="py-2.5 px-3">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= e.severity === 'CRITICAL' ? 'bg-rose-600 text-white' : 'bg-rose-500/20 text-rose-400' %>">
                        <%= e.severity %>
                      </span>
                    </td>
                    <td class="py-2.5 px-3 font-bold text-slate-300"><%= e.service %></td>
                    <td class="py-2.5 px-3 text-slate-200">
                      <div><%= e.message %></div>
                      <% if (e.stack) { %>
                        <div class="text-[10px] text-slate-500 mt-1 font-mono truncate max-w-xl"><%= e.stack.substring(0, 150) %>...</div>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script src="/js/developer.js"></script>
</body>
</html>
