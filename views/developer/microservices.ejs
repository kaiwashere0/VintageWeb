<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Microservices Controller — Vintage Club" %></title>
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/output.css">
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="min-h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB] flex font-sans antialiased selection:bg-[#8C5137] selection:text-white">

  <!-- DEVELOPER SIDEBAR -->
  <%- include('partials/sidebar', { currentPath: '/developer/microservices' }) %>

  <!-- MAIN VIEWPORT WRAPPER (Offset by sidebar width on lg) -->
  <div class="flex-1 lg:pl-64 flex flex-col min-h-screen">
    
    <!-- TOP NAVIGATION BAR -->
    <%- include('partials/header', { 
      pageTitle: "Microservice Controller", 
      pageSubtitle: 'Real-time uptime, error tracking, active endpoints and service health' 
    }) %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-8 max-w-7xl w-full mx-auto">

      <!-- SECTION: ALL 5 SYSTEM MICROSERVICES -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Architecture Breakdown</span>
            <h2 class="text-xl font-extrabold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Active Microservices (5)</h2>
          </div>
          <button id="ping-all-btn" class="btn-secondary px-3.5 py-1.5 rounded-xl text-xs font-mono flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-satellite-dish text-[#8C5137] dark:text-[#D48D66]"></i>
            <span>Health Ping All</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          
          <!-- 1. Database Microservice -->
          <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between space-y-4 shadow-sm hover-lift">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-database"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold font-sans text-[#4A2B1D] dark:text-white"><%= microservices.database.name %></h3>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-400"><%= microservices.database.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
                  <%= microservices.database.status.toUpperCase() %>
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] font-mono text-[11px] space-y-1.5 text-[#4A2B1D] dark:text-slate-300">
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Connection:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.database.state %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Host / Port:</span>
                  <span class="text-[#4A2B1D] dark:text-slate-200"><%= microservices.database.host %>:<%= microservices.database.port %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Database Name:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold"><%= microservices.database.dbName %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Active Models:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.database.modelsCount %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Ping Latency:</span>
                  <span class="text-[#8C5137] dark:text-[#D48D66] font-bold"><%= microservices.database.latencyMs %> ms</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-[#8C5137] dark:text-slate-400 pt-2 border-t border-[#E1E2E4] dark:border-[#262A36]">
              <span>Uptime: <%= Math.floor(microservices.database.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold">Auto-Start Enabled</span>
            </div>
          </div>

          <!-- 2. TruckersMP Web API Microservice -->
          <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between space-y-4 shadow-sm hover-lift">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-xl bg-[#8C5137]/10 dark:bg-[#D48D66]/10 border border-[#8C5137]/20 text-[#8C5137] dark:text-[#D48D66] flex items-center justify-center text-xs">
                    <i class="fa-solid fa-truck-fast"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold font-sans text-[#4A2B1D] dark:text-white"><%= microservices.truckersmp.name %></h3>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-400"><%= microservices.truckersmp.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
                  HEALTHY
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] font-mono text-[11px] space-y-1.5 text-[#4A2B1D] dark:text-slate-300">
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Specification:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white">OpenAPI 3.1 (v2.0)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Active Routes:</span>
                  <span class="text-sky-600 dark:text-sky-400 font-bold"><%= microservices.truckersmp.activeRoutes.length %> Endpoints</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Caching Engine:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold">In-Memory TTL Buffer</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Upstream Base:</span>
                  <span class="text-[#8C5137] dark:text-slate-400 truncate max-w-[140px]"><%= microservices.truckersmp.baseUrl %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Upstream Ping:</span>
                  <span class="text-[#8C5137] dark:text-[#D48D66] font-bold"><%= microservices.truckersmp.latencyMs >= 0 ? `${microservices.truckersmp.latencyMs} ms` : 'Standby' %></span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-[#8C5137] dark:text-slate-400 pt-2 border-t border-[#E1E2E4] dark:border-[#262A36]">
              <a href="/developer/truckersmp" class="text-[#8C5137] dark:text-[#D48D66] hover:underline font-bold">Open API Sandbox &rarr;</a>
              <span>Uptime: <%= Math.floor(microservices.truckersmp.uptimeSeconds / 60) %> mins</span>
            </div>
          </div>

          <!-- 3. Discord Bot Gateway Microservice -->
          <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between space-y-4 shadow-sm hover-lift">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs">
                    <i class="fa-brands fa-discord"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold font-sans text-[#4A2B1D] dark:text-white"><%= microservices.discordBot.name %></h3>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-400"><%= microservices.discordBot.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-500/15 text-indigo-600 dark:text-indigo-400">
                  <%= microservices.discordBot.status.toUpperCase() %>
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] font-mono text-[11px] space-y-1.5 text-[#4A2B1D] dark:text-slate-300">
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Bot Tag:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.discordBot.tag %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Gateway WS Ping:</span>
                  <span class="text-indigo-600 dark:text-indigo-300 font-bold"><%= microservices.discordBot.pingMs %> ms</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Connected Guilds:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.discordBot.guildsCount %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Voice 24/7 Engine:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold">Auto-Reconnect Ready</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-[#8C5137] dark:text-slate-400 pt-2 border-t border-[#E1E2E4] dark:border-[#262A36]">
              <a href="/developer/discord-bot" class="text-[#8C5137] dark:text-[#D48D66] hover:underline font-bold">Manage Bot Controller &rarr;</a>
              <span>Uptime: <%= Math.floor(microservices.discordBot.uptimeSeconds / 60) %> mins</span>
            </div>
          </div>

          <!-- 4. Auth & Security Microservice -->
          <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between space-y-4 shadow-sm hover-lift">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-lock"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold font-sans text-[#4A2B1D] dark:text-white"><%= microservices.auth.name %></h3>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-400"><%= microservices.auth.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400">
                  SECURE
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] font-mono text-[11px] space-y-1.5 text-[#4A2B1D] dark:text-slate-300">
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">OAuth Provider:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.auth.provider %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Secret Encryption:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold"><%= microservices.auth.secretConfigured ? 'SHA-256 HMAC Active' : 'Missing' %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Super Admins:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.auth.superAdminsConfigured %> configured</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Developers:</span>
                  <span class="text-[#8C5137] dark:text-[#D48D66] font-bold"><%= microservices.auth.developersConfigured %> authorized</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-[#8C5137] dark:text-slate-400 pt-2 border-t border-[#E1E2E4] dark:border-[#262A36]">
              <span>Uptime: <%= Math.floor(microservices.auth.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold">Session Guard Active</span>
            </div>
          </div>

          <!-- 5. i18n Localization Microservice -->
          <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between space-y-4 shadow-sm hover-lift">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-xl bg-teal-500/10 border border-teal-500/20 text-teal-600 dark:text-teal-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-language"></i>
                  </div>
                  <div>
                    <h3 class="text-xs font-bold font-sans text-[#4A2B1D] dark:text-white"><%= microservices.i18n.name %></h3>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-400"><%= microservices.i18n.serviceId %></span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-teal-500/15 text-teal-600 dark:text-teal-400">
                  LOADED
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] font-mono text-[11px] space-y-1.5 text-[#4A2B1D] dark:text-slate-300">
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Languages:</span>
                  <span class="font-bold text-[#4A2B1D] dark:text-white"><%= microservices.i18n.languages.map(l => l.toUpperCase()).join(' / ') %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Default Locale:</span>
                  <span class="text-teal-600 dark:text-teal-300 font-bold"><%= microservices.i18n.defaultLang.toUpperCase() %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">IP Geolocation:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold"><%= microservices.i18n.geoDetection %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#8C5137] dark:text-slate-400">Dictionary Keys:</span>
                  <span class="text-[#4A2B1D] dark:text-slate-200 font-bold"><%= Object.values(microservices.i18n.keyCounts).join(' / ') %> keys</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[10px] font-mono text-[#8C5137] dark:text-slate-400 pt-2 border-t border-[#E1E2E4] dark:border-[#262A36]">
              <span>Uptime: <%= Math.floor(microservices.i18n.uptimeSeconds / 60) %> mins</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold">Dynamic Switch Active</span>
            </div>
          </div>

        </div>
      </div>

      <!-- SECTION: MICROSERVICE ERROR LOGS TELEMETRY TABLE -->
      <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
          <div>
            <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Live Telemetry</span>
            <h2 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Service Error Logs & Stack Traces</h2>
          </div>
          <button id="clear-error-logs-btn" class="px-3 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 text-xs font-mono flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-trash text-[10px]"></i>
            <span>Clear Error Buffer</span>
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs">
            <thead>
              <tr class="text-[#8C5137] dark:text-slate-400 border-b border-[#E1E2E4] dark:border-[#262A36] text-[11px]">
                <th class="py-2.5 px-3">TIMESTAMP</th>
                <th class="py-2.5 px-3">LEVEL</th>
                <th class="py-2.5 px-3">MICROSERVICE</th>
                <th class="py-2.5 px-3">ERROR MESSAGE / STACK</th>
              </tr>
            </thead>
            <tbody id="telemetry-errors-table-body">
              <% if (!errorLogs || errorLogs.length === 0) { %>
                <tr>
                  <td colspan="4" class="py-8 text-center text-xs text-emerald-600 dark:text-emerald-400 font-mono">
                    <i class="fa-solid fa-circle-check mr-1.5"></i> Zero microservice errors recorded. All systems operating normally.
                  </td>
                </tr>
              <% } else { %>
                <% errorLogs.forEach(function(e) { %>
                  <tr class="border-b border-[#E1E2E4] dark:border-[#262A36] hover:bg-[#F8F9FA] dark:hover:bg-[#151922] transition-colors">
                    <td class="py-2.5 px-3 text-[#8C5137] dark:text-slate-400"><%= new Date(e.time).toLocaleTimeString() %></td>
                    <td class="py-2.5 px-3">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= e.severity === 'CRITICAL' ? 'bg-rose-600 text-white' : 'bg-rose-500/15 text-rose-600 dark:text-rose-400' %>">
                        <%= e.severity %>
                      </span>
                    </td>
                    <td class="py-2.5 px-3 font-bold text-[#4A2B1D] dark:text-slate-200"><%= e.service %></td>
                    <td class="py-2.5 px-3 text-[#4A2B1D] dark:text-slate-200">
                      <div><%= e.message %></div>
                      <% if (e.stack) { %>
                        <div class="text-[10px] text-[#8C5137] dark:text-slate-500 mt-1 font-mono truncate max-w-xl"><%= e.stack.substring(0, 150) %>...</div>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script src="/js/developer.js"></script>
</body>
</html>
