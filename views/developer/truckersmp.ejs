<!DOCTYPE html>
<html lang="en" class="h-full bg-[#08090C] text-slate-100">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "TruckersMP API Console — Developer Portal" %></title>
  <link rel="stylesheet" href="/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
</head>

<body class="min-h-full flex bg-[#08090C] text-slate-100 antialiased selection:bg-[#8C5137] selection:text-white">

  <!-- DEVELOPER SIDEBAR -->
  <%- include('partials/sidebar', { currentPath: '/developer/truckersmp' }) %>

  <!-- MAIN DEVELOPER WORKSPACE -->
  <div class="flex-1 flex flex-col min-w-0 lg:pl-64">
    
    <!-- TOP HEADER -->
    <%- include('partials/header', { 
      pageTitle: "TruckersMP Web API v2 Console", 
      pageSubtitle: 'OpenAPI 3.1 schema implementation, active route registry & sandbox tester' 
    }) %>

    <main class="p-4 sm:p-8 space-y-8 flex-1">

      <!-- SECTION 1: INTERACTIVE SANDBOX TESTER -->
      <div class="p-6 rounded-2xl bg-[#0F1219] border border-[#1E232E]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-[#1E232E]">
          <div>
            <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#D48D66]">OpenAPI 3.1 Live Sandbox</span>
            <h2 class="text-xl font-bold text-white font-sans mt-0.5">Interactive TruckersMP API Tester</h2>
          </div>
          <div class="flex items-center gap-2">
            <span id="sandbox-status-badge" class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">READY</span>
          </div>
        </div>

        <form id="tmp-sandbox-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            
            <div>
              <label class="block text-xs font-mono text-slate-400 mb-1.5 uppercase">Target Endpoint</label>
              <select id="sandbox-endpoint" class="w-full px-3 py-2.5 rounded-xl border border-[#1E232E] bg-[#151922] font-mono text-xs text-white focus:outline-none focus:border-[#8C5137]">
                <option value="servers">GET /servers (Live Fleet Servers)</option>
                <option value="game_time">GET /game_time (In-game Clock)</option>
                <option value="events">GET /events (Featured & Upcoming Events)</option>
                <option value="version">GET /version (ETS2/ATS Compatibility)</option>
                <option value="rules">GET /rules (Official Rules)</option>
                <option value="player">GET /player/{id} (Player Profile)</option>
                <option value="bans">GET /bans/{id} (Player Ban Records)</option>
                <option value="vtc">GET /vtc/{id} (VTC Information)</option>
                <option value="vtc_members">GET /vtc/{id}/members (VTC Member Roster)</option>
                <option value="vtc_events">GET /vtc/{id}/events (VTC Event Calendar)</option>
              </select>
            </div>

            <div id="sandbox-id-container" style="display: none;">
              <label class="block text-xs font-mono text-slate-400 mb-1.5 uppercase">Identifier (ID / SteamID64 / VTC ID)</label>
              <input type="text" id="sandbox-id" placeholder="e.g. 76561198000000000 or 12345" class="w-full px-3 py-2.5 rounded-xl border border-[#1E232E] bg-[#151922] font-mono text-xs text-white focus:outline-none focus:border-[#8C5137]" />
            </div>

            <div class="flex items-end">
              <button type="submit" id="sandbox-submit-btn" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#8C5137] to-[#D48D66] hover:from-[#9C5B3E] hover:to-[#DE9670] text-xs font-mono font-bold text-white transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer">
                <i class="fa-solid fa-play"></i>
                <span>Run Sandbox Test</span>
              </button>
            </div>

          </div>
        </form>

        <!-- Response Console -->
        <div class="mt-6">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
            <span>RESPONSE PAYLOAD (JSON)</span>
            <span>Content-Type: application/json</span>
          </div>
          <div class="p-4 rounded-xl bg-[#08090C] border border-[#1E232E] overflow-x-auto max-h-96">
            <pre id="sandbox-response-code" class="text-xs font-mono text-emerald-400 whitespace-pre-wrap">{
  "status": "ready",
  "message": "Select an endpoint above and click 'Run Sandbox Test' to inspect live responses."
}</pre>
          </div>
        </div>
      </div>

      <!-- SECTION 2: SPECIFICATION ROUTE REGISTRY -->
      <div class="p-6 rounded-2xl bg-[#0F1219] border border-[#1E232E]">
        <div class="mb-4 pb-3 border-b border-[#1E232E]">
          <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-sky-400">Documentation & Schema</span>
          <h2 class="text-base font-bold text-white font-sans mt-0.5">Implemented TruckersMP API Routes</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
          
          <div class="p-3.5 rounded-xl bg-[#151922] border border-[#1E232E] flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-500/20 text-sky-400">GET</span>
                <span class="text-white font-bold">/player/{id}</span>
              </div>
              <span class="text-[11px] text-slate-400">SteamID64 / TruckersMP ID user details</span>
            </div>
            <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">Cached 5m</span>
          </div>

          <div class="p-3.5 rounded-xl bg-[#151922] border border-[#1E232E] flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-500/20 text-sky-400">GET</span>
                <span class="text-white font-bold">/bans/{id}</span>
              </div>
              <span class="text-[11px] text-slate-400">Player ban history and active ban state</span>
            </div>
            <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">Cached 2m</span>
          </div>

          <div class="p-3.5 rounded-xl bg-[#151922] border border-[#1E232E] flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-500/20 text-sky-400">GET</span>
                <span class="text-white font-bold">/servers</span>
              </div>
              <span class="text-[11px] text-slate-400">Real-time simulation server status & queues</span>
            </div>
            <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">Cached 30s</span>
          </div>

          <div class="p-3.5 rounded-xl bg-[#151922] border border-[#1E232E] flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-500/20 text-sky-400">GET</span>
                <span class="text-white font-bold">/events</span>
              </div>
              <span class="text-[11px] text-slate-400">Public & featured VTC convoy events</span>
            </div>
            <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">Cached 5m</span>
          </div>

        </div>
      </div>

    </main>
  </div>

  <script src="/js/developer.js"></script>
</body>
</html>
