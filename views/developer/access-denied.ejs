<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Developer Access Denied — Vintage Club" %></title>
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/output.css">
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="min-h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB] flex items-center justify-center p-4 font-sans antialiased selection:bg-[#8C5137] selection:text-white">

  <div class="max-w-md w-full clean-card p-8 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] text-center space-y-6 shadow-2xl animate-fade-in-up">
    
    <!-- Shield Alert Icon -->
    <div class="w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 mx-auto flex items-center justify-center text-2xl shadow-sm">
      <i class="fa-solid fa-shield-halved"></i>
    </div>

    <!-- Title & Description -->
    <div class="space-y-2">
      <h1 class="text-2xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">Developer Access Restricted</h1>
      <p class="text-xs text-[#8C5137] dark:text-slate-400 leading-relaxed">
        This area is restricted to authorized Vintage Club Developers and Super Administrators. Your Discord account (<strong class="text-[#4A2B1D] dark:text-white"><%= (typeof user !== 'undefined' && user?.username) ? user.username : 'User' %></strong>) does not have developer privileges.
      </p>
    </div>

    <!-- User Details Box -->
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] font-mono text-xs text-[#4A2B1D] dark:text-slate-300 flex items-center justify-between">
        <span>Discord ID:</span>
        <span class="text-[#8C5137] dark:text-[#D48D66] font-bold"><%= user.discordId || 'N/A' %></span>
      </div>
    <% } %>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
      <a href="/" class="btn-primary w-full py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 shadow-md">
        <i class="fa-solid fa-house"></i>
        <span>Return Home</span>
      </a>
      <a href="/auth/logout" class="btn-secondary w-full py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2">
        <i class="fa-solid fa-right-from-bracket"></i>
        <span>Switch Account</span>
      </a>
    </div>

  </div>

</body>
</html>
