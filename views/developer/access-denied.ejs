<!DOCTYPE html>
<html lang="en" class="h-full bg-[#08090C] text-slate-100">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Developer Access Denied — Vintage Club' %></title>
  <link rel="stylesheet" href="/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
</head>

<body class="h-full flex items-center justify-center p-6 bg-[#08090C] font-sans selection:bg-[#8C5137] selection:text-white">

  <div class="max-w-md w-full p-8 rounded-2xl bg-[#0F1117] border border-rose-500/30 text-center shadow-2xl relative overflow-hidden">
    
    <div class="absolute -top-12 -right-12 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl"></div>
    <div class="absolute -bottom-12 -left-12 w-32 h-32 bg-[#8C5137]/10 rounded-full blur-2xl"></div>

    <div class="w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-500 text-2xl flex items-center justify-center mx-auto mb-5 shadow-inner">
      <i class="fa-solid fa-terminal"></i>
    </div>

    <span class="text-[10px] uppercase font-bold tracking-widest text-rose-400 bg-rose-500/10 px-3 py-1 rounded-full border border-rose-500/20">
      403 RESTRICTED ACCESS
    </span>

    <h1 class="text-xl font-bold text-white mt-4 font-sans">Developer Authentication Required</h1>
    
    <p class="text-xs text-slate-400 mt-2 leading-relaxed">
      This workstation is restricted exclusively to system developers authorized in <code class="text-rose-400 bg-[#181B24] px-1.5 py-0.5 rounded">.env</code> via <code class="text-rose-400 bg-[#181B24] px-1.5 py-0.5 rounded">DEVELOPER_IDS</code>.
    </p>

    <% if (typeof user !== 'undefined' && user) { %>
      <div class="mt-5 p-3 rounded-xl bg-[#181B24] border border-[#262A36] text-left text-xs text-slate-300">
        <div class="flex items-center gap-2 mb-1.5">
          <img src="<%= user.avatarUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" class="w-5 h-5 rounded-full" />
          <span class="font-bold text-white"><%= user.globalName || user.username %></span>
        </div>
        <div class="text-[10px] text-slate-500">
          Discord Snowflake: <span class="font-mono text-slate-300"><%= user.discordId %></span>
        </div>
      </div>
    <% } %>

    <div class="mt-6 flex flex-col sm:flex-row gap-2">
      <a href="/" class="flex-1 py-2.5 px-4 rounded-xl border border-[#262A36] bg-[#181B24] hover:bg-[#202430] text-xs font-semibold text-slate-300 transition-colors">
        <i class="fa-solid fa-globe mr-1.5"></i> Back to Main Site
      </a>
      <a href="/auth/discord?redirect=/developer" class="flex-1 py-2.5 px-4 rounded-xl bg-[#8C5137] hover:bg-[#A35F42] text-xs font-bold text-white transition-colors shadow-xs">
        <i class="fa-brands fa-discord mr-1.5"></i> Switch Account
      </a>
    </div>

  </div>

</body>
</html>
