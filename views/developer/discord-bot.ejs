<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Discord Bot Controller — Vintage Club" %></title>
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/output.css">
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="min-h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB] flex font-sans antialiased selection:bg-[#8C5137] selection:text-white">

  <!-- DEVELOPER SIDEBAR -->
  <%- include('partials/sidebar', { currentPath: '/developer/discord-bot' }) %>

  <!-- MAIN VIEWPORT WRAPPER (Offset by sidebar width on lg) -->
  <div class="flex-1 lg:pl-64 flex flex-col min-h-screen">
    
    <!-- TOP NAVIGATION BAR -->
    <%- include('partials/header', { 
      pageTitle: "Discord Bot Controller", 
      pageSubtitle: 'Presence, Live Streaming & Voice Channel 24/7' 
    }) %>

    <!-- MAIN WORKSPACE CONTENT -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl w-full mx-auto">

      <!-- 1. TOP METRICS STRIP -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        
        <!-- Gateway Status -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Gateway Status</span>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full <%= isClientConnected ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500' %>"></span>
              <span class="text-sm font-bold text-[#4A2B1D] dark:text-[#F9FAFB] font-sans">
                <%= isClientConnected ? 'Live & Connected' : 'Standby / Waiting' %>
              </span>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-brands fa-discord"></i>
          </div>
        </div>

        <!-- Bot Identity -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1 min-w-0">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Bot Account</span>
            <div class="text-sm font-bold text-[#4A2B1D] dark:text-[#F9FAFB] font-sans truncate">
              <%= botService.tag || 'Vintage Club#5492' %>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-robot"></i>
          </div>
        </div>

        <!-- Active Presence Mode -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Presence Mode</span>
            <div class="text-sm font-bold text-purple-600 dark:text-purple-400 font-mono flex items-center gap-1.5">
              <i class="fa-solid fa-tower-broadcast text-xs"></i>
              <span id="stat-presence-mode"><%= botSettings.statusType %> (<%= botSettings.statusMode %>)</span>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-[#8C5137]/10 dark:bg-[#D48D66]/10 border border-[#8C5137]/20 text-[#8C5137] dark:text-[#D48D66] flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-sliders"></i>
          </div>
        </div>

        <!-- Rotation Speed -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Rotation Timer</span>
            <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400 font-mono">
              <span id="stat-interval-display"><%= botSettings.rotationIntervalSeconds || 15 %></span>s / switch
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-arrows-spin"></i>
          </div>
        </div>

      </div>

      <!-- 2. MAIN TWO-COLUMN WORKSPACE -->
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">

        <!-- LEFT COLUMN: LIVE DISCORD SIMULATOR & TIPS (5 COLS) -->
        <div class="xl:col-span-5 space-y-6">
          
          <!-- Discord Live Mockup Card -->
          <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-4 shadow-sm">
            
            <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
              <div>
                <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Live Simulation</span>
                <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Discord Profile Preview</h3>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-500/15 text-indigo-600 dark:text-indigo-300 border border-indigo-500/20">
                LIVE WIDGET
              </span>
            </div>

            <!-- DISCORD PROFILE CARD MOCKUP -->
            <div class="rounded-2xl bg-[#232428] border border-[#1E1F22] overflow-hidden shadow-2xl font-sans text-white">
              
              <!-- Banner -->
              <div class="h-16 bg-gradient-to-r from-[#593695] via-[#7B2CBF] to-[#8C5137] relative">
                <div class="absolute inset-0 bg-black/20"></div>
              </div>

              <!-- Avatar & Content -->
              <div class="px-4 pb-4 relative">
                
                <!-- Avatar with status badge -->
                <div class="relative -mt-8 mb-2.5 inline-block">
                  <div class="w-16 h-16 rounded-full border-4 border-[#232428] bg-[#111214] overflow-hidden flex items-center justify-center shadow-lg">
                    <img id="preview-avatar" src="/Wintage_Club_Logo_2050.png" alt="Vintage Club Bot" class="w-full h-full object-cover" />
                  </div>
                  <!-- Status Circle -->
                  <div id="preview-status-indicator" class="absolute bottom-0 right-0 w-5 h-5 rounded-full border-2 border-[#232428] bg-[#593695] flex items-center justify-center text-[8px] text-white" title="Streaming">
                    <i class="fa-solid fa-tower-broadcast"></i>
                  </div>
                </div>

                <!-- Bot Name & Badges -->
                <div class="space-y-0.5">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-bold text-white font-sans">Vintage Club</span>
                    <span class="px-1.5 py-0.2 rounded bg-[#5865F2] text-white text-[9px] font-bold uppercase tracking-wider">
                      BOT
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-400 font-mono">vintageclub#5492</p>
                </div>

                <!-- Divider -->
                <div class="border-t border-[#313338] my-3"></div>

                <!-- ACTIVITY BOX (Streaming Simulation) -->
                <div class="space-y-1.5">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">ACTIVITY</div>
                  
                  <div class="p-3 rounded-xl bg-[#111214] border border-[#313338] flex items-start gap-3">
                    
                    <!-- Activity Icon -->
                    <div id="preview-activity-icon-box" class="w-8 h-8 rounded-lg bg-[#593695] text-white flex items-center justify-center flex-shrink-0 text-xs shadow-md">
                      <i id="preview-activity-icon" class="fa-solid fa-tower-broadcast"></i>
                    </div>

                    <!-- Activity Details -->
                    <div class="min-w-0 flex-1 space-y-0.5">
                      <div id="preview-activity-title" class="text-xs font-bold text-white font-sans flex items-center gap-1.5">
                        <span id="preview-activity-type-label">Streaming</span>
                        <span class="text-[10px] font-mono text-purple-300 font-normal" id="preview-stream-tag">on Twitch</span>
                      </div>
                      
                      <!-- Animated rotating text preview -->
                      <div id="preview-status-text" class="text-xs text-purple-200 font-semibold truncate transition-all duration-300 font-sans">
                        <%= (botSettings.statuses && botSettings.statuses[0]) || '👑 Vintage Club | 2026' %>
                      </div>

                      <div id="preview-stream-link" class="text-[10px] text-slate-400 font-mono truncate">
                        <%= botSettings.streamingUrl || 'https://twitch.tv/vintageclub' %>
                      </div>
                    </div>

                  </div>
                </div>

                <!-- Interactive simulator ticker -->
                <div class="mt-3 p-2 rounded-lg bg-[#1E1F22] font-mono text-[10px] text-slate-400 flex items-center justify-between border border-[#313338]">
                  <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span id="preview-ticker-label">Cycling (1 of <%= (botSettings.statuses || []).length %>)</span>
                  </div>
                  <button id="preview-next-btn" type="button" class="text-[10px] text-[#D48D66] hover:text-white transition-colors cursor-pointer font-bold" title="Preview Next Status in List">
                    <i class="fa-solid fa-forward-step"></i> Next
                  </button>
                </div>

              </div>

            </div>

            <!-- Information Callout -->
            <div class="p-3.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-xs text-indigo-700 dark:text-indigo-300 space-y-1">
              <div class="font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle-info"></i> Streaming Activity Mode
              </div>
              <p class="text-[11px] text-indigo-800/80 dark:text-indigo-200/80 leading-relaxed">
                Discord displays the purple streaming broadcast badge only when a valid <strong>Twitch</strong> or <strong>YouTube</strong> URL is provided.
              </p>
            </div>

          </div>

        </div>

        <!-- RIGHT COLUMN: CONFIGURATION FORMS (7 COLS) -->
        <div class="xl:col-span-7 space-y-6">
          
          <form id="bot-presence-form" class="space-y-6">

            <!-- Card 1: Core Activity & Status Type -->
            <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-4 shadow-sm">
              
              <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
                <div>
                  <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Presence Setup</span>
                  <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Activity Type & Online Status</h3>
                </div>
                <span class="text-xs font-mono text-[#8C5137] dark:text-slate-400">Step 1</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Activity Type Custom Dropdown Menu -->
                <div class="space-y-1.5 relative custom-dropdown-wrapper" data-dropdown="activity-type">
                  <label class="block text-xs font-bold text-[#4A2B1D] dark:text-slate-300 font-sans flex items-center justify-between">
                    <span>Activity Type <span class="text-rose-500">*</span></span>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-[#D48D66]">Discord Rich Presence</span>
                  </label>
                  
                  <!-- Hidden Form Input -->
                  <input type="hidden" id="bot-status-type" name="statusType" value="<%= botSettings.statusType || 'STREAMING' %>" />
                  
                  <!-- Trigger Button -->
                  <button type="button" id="trigger-activity-type" class="custom-dropdown-trigger w-full px-3.5 py-2.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] hover:border-[#8C5137]/60 dark:hover:border-[#D48D66]/60 transition-all flex items-center justify-between shadow-xs cursor-pointer text-left group">
                    <div class="flex items-center gap-3 min-w-0">
                      <div id="trigger-activity-icon-box" class="w-8 h-8 rounded-lg bg-purple-500/15 border border-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xs flex-shrink-0">
                        <i id="trigger-activity-icon" class="fa-solid fa-tower-broadcast"></i>
                      </div>
                      <div class="min-w-0">
                        <div id="trigger-activity-title" class="text-xs font-bold text-[#4A2B1D] dark:text-white truncate">STREAMING</div>
                        <div id="trigger-activity-desc" class="text-[10px] text-[#8C5137] dark:text-slate-400 truncate">Live Broadcast (Twitch / YouTube)</div>
                      </div>
                    </div>
                    <i class="fa-solid fa-chevron-down text-xs text-[#8C5137] dark:text-[#D48D66] transition-transform duration-200 group-data-[open=true]:rotate-180 flex-shrink-0 ml-2"></i>
                  </button>

                  <!-- Floating Options Menu -->
                  <div id="menu-activity-type" class="custom-dropdown-menu hidden absolute left-0 right-0 top-full mt-2 z-50 p-1.5 rounded-2xl bg-white/95 dark:bg-[#181B24]/95 backdrop-blur-xl border border-[#E1E2E4] dark:border-[#262A36] shadow-2xl space-y-1">
                    
                    <!-- Option: STREAMING -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="STREAMING" data-title="STREAMING" data-desc="Live Broadcast (Twitch / YouTube)" data-icon="fa-tower-broadcast" data-icon-bg="bg-purple-500/15" data-icon-border="border-purple-500/20" data-icon-color="text-purple-600 dark:text-purple-400">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-purple-500/15 border border-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xs">
                          <i class="fa-solid fa-tower-broadcast"></i>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white flex items-center gap-1.5">
                            <span>STREAMING</span>
                            <span class="px-1.5 py-0.2 rounded text-[9px] font-mono bg-purple-500/15 text-purple-600 dark:text-purple-300 border border-purple-500/20">Recommended</span>
                          </div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Live Broadcast (Twitch / YouTube)</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: PLAYING -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="PLAYING" data-title="PLAYING" data-desc="Game Activity Status" data-icon="fa-gamepad" data-icon-bg="bg-indigo-500/15" data-icon-border="border-indigo-500/20" data-icon-color="text-indigo-600 dark:text-indigo-400">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-indigo-500/15 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs">
                          <i class="fa-solid fa-gamepad"></i>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">PLAYING</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Game Activity Status</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: LISTENING -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="LISTENING" data-title="LISTENING" data-desc="Listening to Spotify / Music" data-icon="fa-headphones" data-icon-bg="bg-emerald-500/15" data-icon-border="border-emerald-500/20" data-icon-color="text-emerald-600 dark:text-emerald-400">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs">
                          <i class="fa-solid fa-headphones"></i>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">LISTENING</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Listening to Spotify / Music</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: WATCHING -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="WATCHING" data-title="WATCHING" data-desc="Stream / Video / Premiere" data-icon="fa-tv" data-icon-bg="bg-sky-500/15" data-icon-border="border-sky-500/20" data-icon-color="text-sky-600 dark:text-sky-400">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-500/15 border border-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xs">
                          <i class="fa-solid fa-tv"></i>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">WATCHING</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Stream / Video / Premiere</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: COMPETING -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="COMPETING" data-title="COMPETING" data-desc="Tournament / Ranked Arena" data-icon="fa-trophy" data-icon-bg="bg-amber-500/15" data-icon-border="border-amber-500/20" data-icon-color="text-amber-600 dark:text-amber-400">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">
                          <i class="fa-solid fa-trophy"></i>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">COMPETING</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Tournament / Ranked Arena</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                  </div>
                </div>

                <!-- Online Status Custom Dropdown Menu -->
                <div class="space-y-1.5 relative custom-dropdown-wrapper" data-dropdown="online-status">
                  <label class="block text-xs font-bold text-[#4A2B1D] dark:text-slate-300 font-sans flex items-center justify-between">
                    <span>Discord Online Status</span>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-[#D48D66]">Avatar Indicator</span>
                  </label>
                  
                  <!-- Hidden Form Input -->
                  <input type="hidden" id="bot-online-status" name="onlineStatus" value="<%= botSettings.onlineStatus || 'online' %>" />
                  
                  <!-- Trigger Button -->
                  <button type="button" id="trigger-online-status" class="custom-dropdown-trigger w-full px-3.5 py-2.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] hover:border-[#8C5137]/60 dark:hover:border-[#D48D66]/60 transition-all flex items-center justify-between shadow-xs cursor-pointer text-left group">
                    <div class="flex items-center gap-3 min-w-0">
                      <div id="trigger-online-icon-box" class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/20 flex items-center justify-center flex-shrink-0">
                        <span id="trigger-online-dot" class="w-3 h-3 rounded-full bg-emerald-500 ring-4 ring-emerald-500/20"></span>
                      </div>
                      <div class="min-w-0">
                        <div id="trigger-online-title" class="text-xs font-bold text-[#4A2B1D] dark:text-white truncate">Online (Active)</div>
                        <div id="trigger-online-desc" class="text-[10px] text-[#8C5137] dark:text-slate-400 truncate">Visible green presence indicator</div>
                      </div>
                    </div>
                    <i class="fa-solid fa-chevron-down text-xs text-[#8C5137] dark:text-[#D48D66] transition-transform duration-200 group-data-[open=true]:rotate-180 flex-shrink-0 ml-2"></i>
                  </button>

                  <!-- Floating Options Menu -->
                  <div id="menu-online-status" class="custom-dropdown-menu hidden absolute left-0 right-0 top-full mt-2 z-50 p-1.5 rounded-2xl bg-white/95 dark:bg-[#181B24]/95 backdrop-blur-xl border border-[#E1E2E4] dark:border-[#262A36] shadow-2xl space-y-1">
                    
                    <!-- Option: online -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="online" data-title="Online (Active)" data-desc="Visible green presence indicator" data-dot-color="bg-emerald-500" data-dot-ring="ring-emerald-500/20" data-box-bg="bg-emerald-500/15" data-box-border="border-emerald-500/20">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/20 flex items-center justify-center">
                          <span class="w-3 h-3 rounded-full bg-emerald-500 ring-4 ring-emerald-500/20"></span>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">Online (Active)</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Visible green presence indicator</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: idle -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="idle" data-title="Idle (Away)" data-desc="Amber idle indicator" data-dot-color="bg-amber-500" data-dot-ring="ring-amber-500/20" data-box-bg="bg-amber-500/15" data-box-border="border-amber-500/20">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-500/20 flex items-center justify-center">
                          <span class="w-3 h-3 rounded-full bg-amber-500 ring-4 ring-amber-500/20"></span>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">Idle (Away)</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Amber idle indicator</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: dnd -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="dnd" data-title="Do Not Disturb" data-desc="Red indicator • Notifications muted" data-dot-color="bg-rose-500" data-dot-ring="ring-rose-500/20" data-box-bg="bg-rose-500/15" data-box-border="border-rose-500/20">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-rose-500/15 border border-rose-500/20 flex items-center justify-center">
                          <span class="w-3 h-3 rounded-full bg-rose-500 ring-4 ring-rose-500/20"></span>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">Do Not Disturb</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Red indicator • Notifications muted</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                    <!-- Option: invisible -->
                    <div class="custom-dropdown-option p-2.5 rounded-xl flex items-center justify-between cursor-pointer hover:bg-[#8C5137]/10 dark:hover:bg-[#D48D66]/10 transition-colors" data-value="invisible" data-title="Invisible (Offline)" data-desc="Gray indicator • Appear offline" data-dot-color="bg-slate-400" data-dot-ring="ring-slate-400/20" data-box-bg="bg-slate-500/15" data-box-border="border-slate-500/20">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-slate-500/15 border border-slate-500/20 flex items-center justify-center">
                          <span class="w-3 h-3 rounded-full bg-slate-400 ring-4 ring-slate-400/20"></span>
                        </div>
                        <div>
                          <div class="text-xs font-bold text-[#4A2B1D] dark:text-white">Invisible (Offline)</div>
                          <p class="text-[10px] text-[#8C5137] dark:text-slate-400">Gray indicator • Appear offline</p>
                        </div>
                      </div>
                      <i class="option-check fa-solid fa-check text-xs text-[#8C5137] dark:text-[#D48D66] hidden"></i>
                    </div>

                  </div>
                </div>

              </div>

              <!-- Streaming URL Input -->
              <div id="streaming-url-container" class="space-y-1.5 pt-2 border-t border-[#E1E2E4] dark:border-[#262A36] <%= botSettings.statusType === 'STREAMING' ? '' : 'opacity-60' %>">
                <label class="block text-xs font-bold text-[#4A2B1D] dark:text-slate-300 font-sans flex items-center justify-between">
                  <span>Stream URL (Twitch or YouTube Channel Link)</span>
                  <span class="text-[10px] font-mono text-purple-600 dark:text-purple-400 font-normal">Required for Streaming Badge</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-purple-600 dark:text-purple-400 text-xs">
                    <i class="fa-brands fa-twitch"></i>
                  </div>
                  <input type="url" id="bot-streaming-url" name="streamingUrl" value="<%= botSettings.streamingUrl || 'https://twitch.tv/vintageclub' %>" placeholder="https://twitch.tv/vintageclub" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-mono focus:outline-none focus:border-[#8C5137] transition-colors" />
                </div>
              </div>

            </div>

            <!-- Card 2: Rotation Mode & Interval Timeline -->
            <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-5 shadow-sm">
              
              <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
                <div>
                  <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Timing & Schedule</span>
                  <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Rotation Mode & Interval Timeline</h3>
                </div>
                <span class="text-xs font-mono text-[#8C5137] dark:text-slate-400">Step 2</span>
              </div>

              <!-- Mode Selection -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36]">
                <div class="space-y-0.5">
                  <span class="text-xs font-bold text-[#4A2B1D] dark:text-white font-sans block">Operational Mode</span>
                  <span class="text-[11px] text-[#8C5137] dark:text-slate-400">Cycle through multiple messages or display a fixed single status</span>
                </div>
                <div class="flex items-center gap-4">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="statusMode" value="ROTATING" <%= botSettings.statusMode === 'ROTATING' ? 'checked' : '' %> class="text-[#8C5137] focus:ring-[#8C5137] bg-white dark:bg-[#0F1219] border-[#E1E2E4] dark:border-[#1E232E]" />
                    <span class="text-xs font-semibold text-[#4A2B1D] dark:text-white">Rotating (Multi-Message)</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="statusMode" value="STATIC" <%= botSettings.statusMode === 'STATIC' ? 'checked' : '' %> class="text-[#8C5137] focus:ring-[#8C5137] bg-white dark:bg-[#0F1219] border-[#E1E2E4] dark:border-[#1E232E]" />
                    <span class="text-xs font-semibold text-[#8C5137] dark:text-slate-300">Static (Single Message)</span>
                  </label>
                </div>
              </div>

              <!-- Rotation Interval Interactive Timeline Schedule -->
              <div id="interval-slider-box" class="space-y-4 pt-2">
                
                <div class="flex items-center justify-between">
                  <div class="space-y-0.5">
                    <label class="text-xs font-bold text-[#4A2B1D] dark:text-slate-200 font-sans flex items-center gap-2">
                      <i class="fa-solid fa-clock-rotate-left text-[#8C5137] dark:text-[#D48D66]"></i>
                      <span>Rotation Interval Duration</span>
                    </label>
                    <p class="text-[11px] text-[#8C5137] dark:text-slate-400">Time elapsed before advancing to the next status message</p>
                  </div>
                  
                  <!-- Dynamic Time Badge -->
                  <div class="px-3 py-1 rounded-xl bg-[#8C5137]/15 dark:bg-[#8C5137]/20 border border-[#8C5137]/30 text-[#8C5137] dark:text-[#D48D66] text-xs font-mono font-bold flex items-center gap-1.5 shadow-xs">
                    <i class="fa-solid fa-stopwatch text-[11px] animate-pulse"></i>
                    <span><span id="interval-val-text"><%= botSettings.rotationIntervalSeconds || 15 %></span> seconds / cycle</span>
                  </div>
                </div>

                <!-- Custom Styled Range Slider -->
                <div class="py-2 px-1">
                  <input type="range" id="bot-rotation-interval" name="rotationIntervalSeconds" min="5" max="60" step="5" value="<%= botSettings.rotationIntervalSeconds || 15 %>" class="custom-range-slider" />
                </div>

                <!-- Timeline Ruler & Preset Buttons -->
                <div class="space-y-2">
                  <div class="grid grid-cols-6 gap-2 pt-1">
                    <% [5, 10, 15, 30, 45, 60].forEach(function(sec) { %>
                      <button type="button" data-seconds="<%= sec %>" class="timeline-step-btn py-1.5 px-2 rounded-lg bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[11px] font-mono font-semibold text-[#4A2B1D] dark:text-slate-300 flex flex-col items-center justify-center gap-0.5 cursor-pointer <%= (botSettings.rotationIntervalSeconds || 15) == sec ? 'is-active' : '' %>">
                        <span><%= sec %>s</span>
                        <span class="text-[8px] opacity-70 font-sans"><%= sec === 5 ? 'Fast' : (sec === 15 ? 'Recommended' : (sec === 60 ? 'Slow' : 'Step')) %></span>
                      </button>
                    <% }); %>
                  </div>

                  <div class="flex items-center justify-between text-[10px] font-mono text-[#8C5137] dark:text-slate-500 px-1">
                    <span>⚡ Minimum: 5 Seconds</span>
                    <span>⏱️ Maximum: 60 Seconds</span>
                  </div>
                </div>

              </div>

            </div>

            <!-- Card 3: 24/7 Voice Channel Connection -->
            <% const voiceConfig = botSettings.voiceChannel || {}; %>
            <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-5 shadow-sm">
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
                <div class="space-y-0.5">
                  <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-indigo-600 dark:text-indigo-400">Voice 24/7 Engine</span>
                  <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-volume-high text-indigo-600 dark:text-indigo-400"></i>
                    <span>24/7 Voice Channel Connection</span>
                  </h3>
                </div>
                
                <!-- Live Voice Connection Status Badge -->
                <div id="voice-status-badge" class="px-3 py-1 rounded-xl font-mono text-xs font-bold flex items-center gap-2 <%= (typeof voiceStatus !== 'undefined' && voiceStatus.connected) ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30' : 'bg-[#F8F9FA] dark:bg-[#13161D] text-[#8C5137] dark:text-slate-400 border border-[#E1E2E4] dark:border-[#262A36]' %>">
                  <span class="w-2 h-2 rounded-full <%= (typeof voiceStatus !== 'undefined' && voiceStatus.connected) ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400 dark:bg-slate-500' %>"></span>
                  <span id="voice-status-text">
                    <%= (typeof voiceStatus !== 'undefined' && voiceStatus.connected) ? `Connected: #${voiceStatus.channelName}` : 'No Voice Connection' %>
                  </span>
                </div>
              </div>

              <!-- Voice Enable Toggle -->
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36]">
                <div class="space-y-0.5">
                  <span class="text-xs font-bold text-[#4A2B1D] dark:text-white font-sans block">Stay Connected 24/7 in Voice Channel</span>
                  <span class="text-[11px] text-[#8C5137] dark:text-slate-400">Bot automatically joins on startup and reconnects immediately if disconnected</span>
                </div>
                <label class="custom-toggle">
                  <input type="checkbox" id="bot-voice-enabled" <%= voiceConfig.enabled ? 'checked' : '' %> />
                  <span class="toggle-track">
                    <span class="toggle-thumb"></span>
                  </span>
                </label>
              </div>

              <!-- Guild ID & Voice Channel ID Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Guild ID Input -->
                <div class="space-y-1.5">
                  <label class="block text-xs font-bold text-[#4A2B1D] dark:text-slate-300 font-sans flex items-center justify-between">
                    <span>Guild ID (Server ID)</span>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-500">Discord Server ID</span>
                  </label>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#8C5137] dark:text-slate-400 text-xs">
                      <i class="fa-solid fa-server"></i>
                    </div>
                    <input type="text" id="bot-voice-guild-id" value="<%= voiceConfig.guildId || '' %>" placeholder="e.g. 1243266940873740381" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-mono focus:outline-none focus:border-[#8C5137] transition-colors" />
                  </div>
                </div>

                <!-- Voice Channel ID Input -->
                <div class="space-y-1.5">
                  <label class="block text-xs font-bold text-[#4A2B1D] dark:text-slate-300 font-sans flex items-center justify-between">
                    <span>Voice Channel ID</span>
                    <span class="text-[10px] font-mono text-[#8C5137] dark:text-slate-500">Discord Channel ID</span>
                  </label>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-indigo-600 dark:text-indigo-400 text-xs">
                      <i class="fa-solid fa-microphone"></i>
                    </div>
                    <input type="text" id="bot-voice-channel-id" value="<%= voiceConfig.channelId || '' %>" placeholder="e.g. 1243266940873740382" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-mono focus:outline-none focus:border-[#8C5137] transition-colors" />
                  </div>
                </div>

              </div>

              <!-- Audio Permissions / State Checkboxes -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <label class="custom-checkbox-btn">
                  <input type="checkbox" id="bot-voice-self-deaf" <%= voiceConfig.selfDeaf !== false ? 'checked' : '' %> />
                  <span class="check-icon-box"><i class="fa-solid fa-check"></i></span>
                  <span class="text-xs font-sans">Deafen Bot (Self Deaf — Recommended)</span>
                </label>

                <label class="custom-checkbox-btn">
                  <input type="checkbox" id="bot-voice-self-mute" <%= voiceConfig.selfMute !== false ? 'checked' : '' %> />
                  <span class="check-icon-box"><i class="fa-solid fa-check"></i></span>
                  <span class="text-xs font-sans">Mute Bot Microphone (Self Mute)</span>
                </label>
              </div>

              <!-- Voice Actions Bar -->
              <div class="pt-3 border-t border-[#E1E2E4] dark:border-[#262A36] flex flex-wrap items-center justify-between gap-3">
                <span id="voice-action-feedback" class="text-xs font-mono text-[#8C5137] dark:text-slate-400">Configure channel IDs and broadcast connection.</span>
                <div class="flex items-center gap-2">
                  <button type="button" id="disconnect-voice-btn" class="px-3.5 py-2 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer">
                    <i class="fa-solid fa-phone-slash text-[11px]"></i>
                    <span>Disconnect Voice</span>
                  </button>
                  <button type="button" id="save-connect-voice-btn" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold flex items-center gap-1.5 transition-all shadow-md cursor-pointer">
                    <i class="fa-solid fa-link text-[11px]"></i>
                    <span>Save & Connect</span>
                  </button>
                </div>
              </div>

            </div>

            <!-- Card 4: Status Messages List -->
            <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-4 shadow-sm">
              
              <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
                <div>
                  <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Status Sequence</span>
                  <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Status Messages List</h3>
                </div>
                <button id="add-status-item-btn" type="button" class="px-3 py-1.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-300 hover:bg-indigo-500/20 text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer shadow-xs">
                  <i class="fa-solid fa-plus text-[10px]"></i>
                  <span>Add Message</span>
                </button>
              </div>

              <!-- Status Items Container -->
              <div id="status-items-container" class="space-y-3">
                <% const currentStatuses = (botSettings.statuses && botSettings.statuses.length > 0) ? botSettings.statuses : ['👑 Vintage Club | 2026', '🚛 Nobility on the Roads', '✨ vintageclub.com']; %>
                <% currentStatuses.forEach(function(st, index) { %>
                  <div class="status-row flex items-center gap-2 p-2.5 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] group">
                    <span class="row-index text-xs font-mono font-bold text-[#8C5137] dark:text-slate-400 w-7 text-center flex-shrink-0">#<%= index + 1 %></span>
                    <input type="text" name="statusItem" value="<%= st %>" placeholder="e.g. 👑 Vintage Club | 2026" class="status-input flex-1 px-3 py-2 rounded-lg bg-white dark:bg-[#0F1219] border border-[#E1E2E4] dark:border-[#1E232E] text-[#4A2B1D] dark:text-white text-xs font-sans focus:outline-none focus:border-[#8C5137] transition-colors" required />
                    <button type="button" class="remove-status-btn w-8 h-8 rounded-lg text-[#8C5137] dark:text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 flex items-center justify-center transition-colors cursor-pointer flex-shrink-0" title="Remove Message">
                      <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                  </div>
                <% }); %>
              </div>

              <p class="text-[10px] text-[#8C5137] dark:text-slate-400 font-mono">
                💡 Tip: Custom emojis and symbols are supported. Example: 👑 Vintage Club 🚛 Nobility on the Roads ✨ vintageclub.com
              </p>

            </div>

            <!-- Submit Action Bar -->
            <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
              <div class="flex items-center gap-2 text-xs font-mono text-[#8C5137] dark:text-slate-400">
                <i class="fa-solid fa-cloud-arrow-up text-[#8C5137] dark:text-[#D48D66]"></i>
                <span id="form-status-feedback">Ready to broadcast updates to Discord.</span>
              </div>
              <button type="submit" id="save-bot-form-btn" class="btn-primary px-6 py-3 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-2 shadow-lg cursor-pointer">
                <i class="fa-solid fa-satellite-dish"></i>
                <span>Save & Broadcast to Discord</span>
              </button>
            </div>

          </form>

        </div>

      </div>

    </main>
  </div>

  <script src="/js/developer.js"></script>
</body>
</html>
