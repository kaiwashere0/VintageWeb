<!-- DEVELOPER SIDEBAR (Admin-Themed, Responsive, Full Dark/Light Mode) -->
<aside id="dev-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white dark:bg-[#0C0D11] border-r border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between transition-transform duration-300 -translate-x-full lg:translate-x-0 shadow-xl lg:shadow-none">
  
  <div>
    <!-- Brand Header -->
    <div class="p-5 border-b border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between">
      <a href="/developer" class="flex items-center gap-3 group">
        <img src="/Wintage_Club_Logo_2050.png" alt="Vintage Club" class="h-9 w-auto object-contain transition-transform group-hover:scale-105" />
        <div>
          <span class="block font-heading font-extrabold text-sm text-[#4A2B1D] dark:text-[#F9FAFB] tracking-tight">
            Vintage Club
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">
            Developer Hub
          </span>
        </div>
      </a>
      <button id="close-dev-sidebar-btn" type="button" class="lg:hidden w-8 h-8 rounded-lg bg-[#E1E2E4]/60 dark:bg-[#181B24] text-[#8C5137] dark:text-slate-300 flex items-center justify-center cursor-pointer" aria-label="Close Menu">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Navigation Items -->
    <nav class="p-3 space-y-1.5 font-sans">
      
      <div class="px-3 py-1.5 text-[10px] uppercase font-bold text-[#8C5137] dark:text-[#D48D66] tracking-wider opacity-75">
        Core Monitoring
      </div>

      <!-- Dashboard -->
      <a href="/developer" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof currentPath !== 'undefined' && currentPath === '/developer') ? 'bg-gradient-to-r from-[#8C5137] to-[#D48D66] text-white shadow-sm' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1' %>">
        <i class="fa-solid fa-gauge-high text-sm w-4 transition-transform group-hover:scale-110"></i>
        <span>Dashboard</span>
      </a>

      <!-- Microservices -->
      <a href="/developer/microservices" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof currentPath !== 'undefined' && currentPath === '/developer/microservices') ? 'bg-gradient-to-r from-[#8C5137] to-[#D48D66] text-white shadow-sm' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1' %>">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-cubes-stacked text-sm w-4 transition-transform group-hover:scale-110"></i>
          <span>Microservices</span>
        </div>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-mono font-bold">5 Online</span>
      </a>

      <!-- Telemetry -->
      <a href="/developer/telemetry" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof currentPath !== 'undefined' && currentPath === '/developer/telemetry') ? 'bg-gradient-to-r from-[#8C5137] to-[#D48D66] text-white shadow-sm' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1' %>">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-chart-line text-sm w-4 transition-transform group-hover:scale-110"></i>
          <span>Telemetry & Logs</span>
        </div>
        <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
      </a>

      <div class="pt-3 pb-1 px-3 text-[10px] font-mono uppercase font-bold text-[#8C5137] dark:text-[#D48D66] tracking-wider opacity-75">
        Bot & API Integrations
      </div>

      <!-- Discord Bot Controller -->
      <a href="/developer/discord-bot" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof currentPath !== 'undefined' && currentPath === '/developer/discord-bot') ? 'bg-gradient-to-r from-[#8C5137] to-[#D48D66] text-white shadow-sm' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1' %>">
        <div class="flex items-center gap-3">
          <i class="fa-brands fa-discord text-sm w-4 transition-transform group-hover:scale-110 text-indigo-500 dark:text-indigo-400"></i>
          <span>Discord Bot</span>
        </div>
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-600 dark:text-indigo-300 font-mono font-bold">24/7 Live</span>
      </a>

      <!-- TruckersMP Web API Explorer -->
      <a href="/developer/truckersmp" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof currentPath !== 'undefined' && currentPath === '/developer/truckersmp') ? 'bg-gradient-to-r from-[#8C5137] to-[#D48D66] text-white shadow-sm' : 'text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1' %>">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-truck-fast text-sm w-4 transition-transform group-hover:scale-110"></i>
          <span>TruckersMP Web API</span>
        </div>
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-[#8C5137]/10 dark:bg-[#D48D66]/10 text-[#8C5137] dark:text-[#D48D66] font-mono font-bold">v2.0</span>
      </a>

      <div class="pt-3 pb-1">
        <div class="border-t border-[#E1E2E4] dark:border-[#262A36]"></div>
      </div>

      <!-- Admin Portal Quick Switch -->
      <a href="/admin" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1 transition-all duration-200 group">
        <i class="fa-solid fa-crown text-amber-500 text-sm w-4 transition-transform group-hover:scale-110"></i>
        <span>Admin Portal</span>
      </a>

      <!-- Back to Website -->
      <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#181B24] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] hover:translate-x-1 transition-all duration-200 group">
        <i class="fa-solid fa-globe text-sm w-4 transition-transform group-hover:scale-110"></i>
        <span>Back to Website</span>
      </a>

    </nav>
  </div>

  <!-- Bottom User Profile Card -->
  <div class="p-3 border-t border-[#E1E2E4] dark:border-[#262A36]">
    <div class="p-3 rounded-2xl bg-[#E1E2E4]/40 dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between">
      <div class="flex items-center gap-2.5 min-w-0">
        <img src="<%= (typeof user !== 'undefined' && user?.avatarUrl) ? user.avatarUrl : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" alt="<%= (typeof user !== 'undefined' && user?.username) ? user.username : 'Developer' %>" class="w-8 h-8 rounded-full object-cover border border-[#8C5137]/40 flex-shrink-0" />
        <div class="min-w-0">
          <span class="block text-xs font-bold text-[#4A2B1D] dark:text-[#F9FAFB] truncate">
            <%= (typeof user !== 'undefined' && (user?.globalName || user?.username)) ? (user.globalName || user.username) : 'Developer' %>
          </span>
          <span class="block text-[10px] text-[#8C5137] dark:text-[#D48D66] font-medium truncate">
            Developer Role
          </span>
        </div>
      </div>
      <a href="/auth/logout" class="w-7 h-7 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center justify-center transition-colors flex-shrink-0 cursor-pointer" title="Log Out">
        <i class="fa-solid fa-right-from-bracket text-xs"></i>
      </a>
    </div>
  </div>

</aside>

<!-- Sidebar Overlay for Mobile -->
<div id="dev-sidebar-overlay" class="hidden fixed inset-0 z-40 bg-black/60 backdrop-blur-xs lg:hidden"></div>
