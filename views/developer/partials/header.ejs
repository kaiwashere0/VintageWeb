<!-- DEVELOPER TOP NAVIGATION HEADER (Admin-Themed, Responsive, Full Dark/Light Mode) -->
<header class="sticky top-0 z-30 bg-white/85 dark:bg-[#0C0D11]/85 backdrop-blur-md border-b border-[#E1E2E4] dark:border-[#262A36] px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between transition-all duration-300">
  
  <!-- Left: Mobile Toggle & Breadcrumb -->
  <div class="flex items-center gap-3">
    <button id="open-dev-sidebar-btn" type="button" class="lg:hidden w-9 h-9 rounded-xl bg-[#E1E2E4]/60 dark:bg-[#181B24] text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4] dark:hover:bg-[#202430] transition-colors flex items-center justify-center cursor-pointer" aria-label="Open Menu">
      <i class="fa-solid fa-bars-staggered text-sm"></i>
    </button>
    <div>
      <h1 class="font-heading font-extrabold text-base sm:text-lg text-[#4A2B1D] dark:text-[#F9FAFB] tracking-tight flex items-center gap-2">
        <span><%= typeof pageTitle !== 'undefined' ? pageTitle : "Developer Portal" %></span>
        <span class="text-xs text-[#8C5137] dark:text-[#D48D66] font-normal">/ <%= typeof pageSubtitle !== 'undefined' ? pageSubtitle : 'Control Hub' %></span>
      </h1>
    </div>
  </div>

  <!-- Right: Actions, Theme Toggle & User Info -->
  <div class="flex items-center gap-3">
    
    <!-- Flush Cache Quick Action -->
    <button id="flush-cache-btn" type="button" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-[#E1E2E4] dark:border-[#262A36] bg-white dark:bg-[#181B24] text-xs font-semibold text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#202430] hover:text-[#4A2B1D] dark:hover:text-[#F9FAFB] transition-all cursor-pointer" title="Flush In-Memory Cache">
      <i class="fa-solid fa-arrows-rotate text-[11px] text-[#8C5137] dark:text-[#D48D66]"></i>
      <span>Flush Cache</span>
    </button>

    <!-- Theme Toggle (Dark / Light Switcher) -->
    <button type="button" class="theme-toggle-btn w-9 h-9 rounded-xl border border-[#E1E2E4] dark:border-[#262A36] bg-white dark:bg-[#181B24] text-[#8C5137] dark:text-slate-300 hover:bg-[#E1E2E4]/50 dark:hover:bg-[#202430] hover:scale-105 active:scale-95 transition-all flex items-center justify-center cursor-pointer" title="Toggle Theme">
      <i class="fa-solid fa-moon dark:hidden text-xs"></i>
      <i class="fa-solid fa-sun hidden dark:block text-[#D48D66] text-xs"></i>
    </button>

    <!-- User Quick Profile Button -->
    <div class="flex items-center gap-2 pl-2 border-l border-[#E1E2E4] dark:border-[#262A36]">
      <img src="<%= (typeof user !== 'undefined' && user?.avatarUrl) ? user.avatarUrl : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" class="w-8 h-8 rounded-full object-cover border border-[#8C5137]/50 shadow-xs transition-transform hover:scale-110" />
      <span class="hidden md:inline text-xs font-bold text-[#4A2B1D] dark:text-[#F9FAFB] max-w-[120px] truncate">
        <%= (typeof user !== 'undefined' && (user?.globalName || user?.username)) ? (user.globalName || user.username) : 'Developer' %>
      </span>
    </div>

  </div>

</header>
