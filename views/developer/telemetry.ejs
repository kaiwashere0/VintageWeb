<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Telemetry & Event Stream — Vintage Club" %></title>
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/output.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="min-h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#F9FAFB] flex font-sans antialiased selection:bg-[#8C5137] selection:text-white">

  <!-- DEVELOPER SIDEBAR -->
  <%- include('partials/sidebar', { currentPath: '/developer/telemetry' }) %>

  <!-- MAIN VIEWPORT WRAPPER (Offset by sidebar width on lg) -->
  <div class="flex-1 lg:pl-64 flex flex-col min-h-screen">
    
    <!-- TOP NAVIGATION BAR -->
    <%- include('partials/header', { 
      pageTitle: "Telemetry & Logs", 
      pageSubtitle: 'Real-time multi-dimensional traffic stream, error analyzer & latency charts' 
    }) %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl w-full mx-auto">

      <!-- TOP METRIC CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        
        <!-- Total Requests -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Total Requests</span>
            <div id="stat-telemetry-total-req" class="text-2xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
              <%= telemetry.overview.totalRequests %>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-satellite-dish"></i>
          </div>
        </div>

        <!-- Average Latency -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Average Latency</span>
            <div id="stat-telemetry-avg-lat" class="text-2xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
              <%= telemetry.overview.avgLatencyMs %> ms
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-[#8C5137]/10 dark:bg-[#D48D66]/10 border border-[#8C5137]/20 text-[#8C5137] dark:text-[#D48D66] flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-gauge-high"></i>
          </div>
        </div>

        <!-- Total Errors -->
        <div class="clean-card p-5 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex items-center justify-between shadow-sm hover-lift">
          <div class="space-y-1">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#D48D66] uppercase tracking-wider">Recorded Errors</span>
            <div id="stat-telemetry-total-err" class="text-2xl font-extrabold font-heading <%= telemetry.overview.totalErrors > 0 ? 'text-amber-500' : 'text-emerald-600 dark:text-emerald-400' %>">
              <%= telemetry.overview.totalErrors %>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
        </div>

      </div>

      <!-- MULTI-DIMENSIONAL FILTER CONTROLS BAR -->
      <div class="clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-4 shadow-sm">
        
        <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
          <div>
            <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Query Engine</span>
            <h2 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Telemetry Filtering & Slicing</h2>
          </div>
          <span class="text-xs font-mono text-[#8C5137] dark:text-slate-400">Live AJAX Stream</span>
        </div>

        <form id="telemetry-filter-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
          
          <!-- Search Input -->
          <div class="lg:col-span-2 space-y-1">
            <label class="text-[11px] font-bold text-[#4A2B1D] dark:text-slate-300 font-sans block">Search Path / Keyword</label>
            <input type="text" id="filter-search" placeholder="e.g. /api/v1/events, 200..." class="w-full px-3 py-2 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-mono focus:outline-none focus:border-[#8C5137] transition-colors" />
          </div>

          <!-- Time Range -->
          <div class="space-y-1">
            <label class="text-[11px] font-bold text-[#4A2B1D] dark:text-slate-300 font-sans block">Time Scope</label>
            <select id="filter-timerange" class="w-full px-3 py-2 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-sans focus:outline-none focus:border-[#8C5137] transition-colors cursor-pointer">
              <option value="15m">Past 15 Mins</option>
              <option value="1h" selected>Past 1 Hour</option>
              <option value="24h">Past 24 Hours</option>
              <option value="7d">Past 7 Days</option>
              <option value="all">All Time</option>
            </select>
          </div>

          <!-- Status Code Filter -->
          <div class="space-y-1">
            <label class="text-[11px] font-bold text-[#4A2B1D] dark:text-slate-300 font-sans block">Status Code</label>
            <select id="filter-status" class="w-full px-3 py-2 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-sans focus:outline-none focus:border-[#8C5137] transition-colors cursor-pointer">
              <option value="ALL" selected>All Codes</option>
              <option value="2xx">2xx (Success)</option>
              <option value="3xx">3xx (Redirect)</option>
              <option value="4xx">4xx (Client Error)</option>
              <option value="5xx">5xx (Server Error)</option>
            </select>
          </div>

          <!-- Sort By -->
          <div class="space-y-1">
            <label class="text-[11px] font-bold text-[#4A2B1D] dark:text-slate-300 font-sans block">Sort Field</label>
            <select id="filter-sortby" class="w-full px-3 py-2 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-sans focus:outline-none focus:border-[#8C5137] transition-colors cursor-pointer">
              <option value="timestamp" selected>Timestamp</option>
              <option value="latency">Response Latency</option>
              <option value="status">Status Code</option>
            </select>
          </div>

          <!-- Sort Order -->
          <div class="space-y-1">
            <label class="text-[11px] font-bold text-[#4A2B1D] dark:text-slate-300 font-sans block">Order</label>
            <select id="filter-sortorder" class="w-full px-3 py-2 rounded-xl bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-[#4A2B1D] dark:text-white text-xs font-sans focus:outline-none focus:border-[#8C5137] transition-colors cursor-pointer">
              <option value="desc" selected>Descending</option>
              <option value="asc">Ascending</option>
            </select>
          </div>

        </form>

      </div>

      <!-- TRAFFIC STREAM & CHARTS SECTION -->
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
        
        <!-- LEFT: REQUESTS LOG TABLE (8 Cols) -->
        <div class="xl:col-span-8 clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-4 shadow-sm">
          
          <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36]">
            <div>
              <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-[#8C5137] dark:text-[#D48D66]">Live Stream</span>
              <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">HTTP Request Log Stream</h3>
            </div>
            <span class="text-xs font-mono text-[#8C5137] dark:text-slate-400">Top 100 Entries</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left font-mono text-xs">
              <thead>
                <tr class="text-[#8C5137] dark:text-slate-400 border-b border-[#E1E2E4] dark:border-[#262A36] text-[11px]">
                  <th class="py-2.5 px-3">TIME</th>
                  <th class="py-2.5 px-3">METHOD</th>
                  <th class="py-2.5 px-3">ROUTE / PATH</th>
                  <th class="py-2.5 px-3">STATUS</th>
                  <th class="py-2.5 px-3 text-right">LATENCY</th>
                </tr>
              </thead>
              <tbody id="telemetry-requests-table-body">
                <% if (!telemetry.requests || telemetry.requests.length === 0) { %>
                  <tr>
                    <td colspan="5" class="py-8 text-center text-xs text-[#8C5137] dark:text-slate-400 font-mono">
                      No matching requests recorded in this scope.
                    </td>
                  </tr>
                <% } else { %>
                  <% telemetry.requests.forEach(function(r) { %>
                    <tr class="border-b border-[#E1E2E4] dark:border-[#262A36] hover:bg-[#F8F9FA] dark:hover:bg-[#151922] transition-colors">
                      <td class="py-2.5 px-3 text-[#8C5137] dark:text-slate-400"><%= new Date(r.time).toLocaleTimeString() %></td>
                      <td class="py-2.5 px-3">
                        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold <%= r.method === 'GET' ? 'bg-sky-500/15 text-sky-600 dark:text-sky-400' : 'bg-amber-500/15 text-amber-600 dark:text-amber-400' %>"><%= r.method %></span>
                      </td>
                      <td class="py-2.5 px-3 text-[#4A2B1D] dark:text-slate-200 truncate max-w-[280px]"><%= r.path %></td>
                      <td class="py-2.5 px-3">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= r.status < 300 ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400' : (r.status < 400 ? 'bg-blue-500/15 text-blue-600 dark:text-blue-400' : 'bg-rose-500/15 text-rose-600 dark:text-rose-400') %>"><%= r.status %></span>
                      </td>
                      <td class="py-2.5 px-3 text-right text-[#8C5137] dark:text-[#D48D66] font-bold"><%= r.durationMs %> ms</td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Table Pagination Footer -->
          <div id="telemetry-pagination" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-[#E1E2E4] dark:border-[#262A36]">
            <div class="flex items-center gap-2">
              <span id="telemetry-pagination-info" class="text-xs font-mono text-[#8C5137] dark:text-slate-400">
                Showing <strong id="page-start-idx" class="text-[#4A2B1D] dark:text-white">1</strong> to <strong id="page-end-idx" class="text-[#4A2B1D] dark:text-white">10</strong> of <strong id="page-total-count" class="text-[#4A2B1D] dark:text-white"><%= (telemetry.requests || []).length %></strong> requests
              </span>
              <span class="text-xs text-[#E1E2E4] dark:text-[#262A36]">|</span>
              <div class="flex items-center gap-1.5 text-xs text-[#8C5137] dark:text-slate-400 font-mono">
                <span>Per page:</span>
                <select id="telemetry-page-size" class="px-2 py-1 rounded-lg bg-[#F8F9FA] dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-xs font-mono text-[#4A2B1D] dark:text-white cursor-pointer focus:outline-none focus:border-[#8C5137]">
                  <option value="10" selected>10</option>
                  <option value="20">20</option>
                  <option value="50">50</option>
                </select>
              </div>
            </div>

            <!-- Page Buttons Container -->
            <div id="telemetry-pagination-buttons" class="flex items-center gap-1 self-end sm:self-auto font-mono text-xs">
              <!-- Rendered via JavaScript -->
            </div>
          </div>

        </div>

        <!-- RIGHT: LIVE MEMORY & CPU TIMELINE (4 Cols) -->
        <div class="xl:col-span-4 clean-card p-6 bg-white dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] flex flex-col justify-between shadow-sm">
          
          <div class="flex items-center justify-between pb-3 border-b border-[#E1E2E4] dark:border-[#262A36] mb-4">
            <div>
              <span class="text-[10px] font-mono uppercase font-bold tracking-widest text-purple-600 dark:text-purple-400">Process Resources</span>
              <h3 class="text-base font-bold font-heading text-[#4A2B1D] dark:text-white mt-0.5">Heap & RSS Memory (MB)</h3>
            </div>
          </div>

          <div class="h-64 w-full">
            <canvas id="chart-memory"></canvas>
          </div>

        </div>

      </div>

    </main>
  </div>

  <script src="/js/developer.js"></script>
</body>
</html>
