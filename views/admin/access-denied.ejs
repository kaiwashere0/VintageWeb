<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#000000] text-[#4A2B1D] dark:text-[#FFFFFF]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Access Denied — Vintage Club</title>
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-full flex items-center justify-center p-4 bg-[#FFFFFF] dark:bg-[#000000] text-[#4A2B1D] dark:text-[#FFFFFF]">

  <div class="clean-card p-8 sm:p-10 max-w-md w-full text-center bg-white dark:bg-[#120B07] border-rose-500/30 shadow-2xl relative overflow-hidden">
    
    <!-- Red Accent Top Glow -->
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-40 h-40 bg-rose-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-rose-500/10 text-rose-500 flex items-center justify-center text-3xl">
      <i class="fa-solid fa-lock"></i>
    </div>

    <h2 class="font-heading font-extrabold text-2xl text-[#4A2B1D] dark:text-white tracking-tight mb-2">
      Access Denied (403)
    </h2>

    <p class="text-xs sm:text-sm text-[#8C5137] dark:text-[#E1E2E4] leading-relaxed mb-6">
      This area is restricted to authorized <strong class="text-[#4A2B1D] dark:text-white">Vintage Club Management</strong>. Your account does not have permission to access this portal.
    </p>

    <% if (typeof user !== 'undefined' && user) { %>
      <div class="p-3.5 rounded-2xl bg-[#E1E2E4]/50 dark:bg-[#1A100A] border border-[#E1E2E4] dark:border-[#4A2B1D] text-left mb-6 text-xs space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-[#8C5137] dark:text-[#E1E2E4]/70">Connected Account:</span>
          <span class="font-bold text-[#4A2B1D] dark:text-white"><%= user.globalName || user.username %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[#8C5137] dark:text-[#E1E2E4]/70">Discord:</span>
          <span class="font-mono text-[11px] text-[#AA6343]">@<%= user.username %></span>
        </div>
      </div>
    <% } %>

    <div class="flex flex-col sm:flex-row items-center gap-3">
      <a href="/" class="w-full py-2.5 btn-primary text-xs font-semibold rounded-xl text-center">
        Return Home
      </a>
      <a href="/auth/logout" class="w-full py-2.5 btn-secondary text-xs font-semibold rounded-xl text-center text-rose-600 dark:text-rose-400">
        Switch Account
      </a>
    </div>

  </div>

</body>
</html>

