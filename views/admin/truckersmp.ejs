<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'TruckersMP Staff Tools — Vintage Club' %></title>
  <link rel="stylesheet" href="/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="min-h-full flex bg-[#F8F9FA] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF] antialiased selection:bg-[#8C5137] selection:text-white">

  <!-- ADMIN SIDEBAR -->
  <%- include('partials/sidebar', { currentPath: '/admin/truckersmp' }) %>

  <!-- MAIN ADMIN CONTENT AREA -->
  <div class="flex-1 flex flex-col min-w-0 lg:pl-64">
    
    <!-- Top Header Bar -->
    <header class="sticky top-0 z-40 bg-white/80 dark:bg-[#0C0D11]/80 backdrop-blur-md border-b border-[#E1E2E4] dark:border-[#262A36] px-4 sm:px-8 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <button id="open-admin-sidebar-btn" type="button" class="lg:hidden w-9 h-9 rounded-xl bg-[#E1E2E4]/60 dark:bg-[#181B24] text-[#8C5137] dark:text-slate-300 flex items-center justify-center cursor-pointer">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h1 class="text-base sm:text-lg font-bold font-heading text-[#4A2B1D] dark:text-white">TruckersMP Staff Tools</h1>
          <p class="text-xs text-[#8C5137] dark:text-slate-400">Driver verification, ban history, and simulation server monitor</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" class="theme-toggle-btn w-9 h-9 rounded-xl border border-[#E1E2E4] dark:border-[#262A36] bg-white dark:bg-[#181B24] text-[#8C5137] dark:text-slate-300 flex items-center justify-center cursor-pointer">
          <i class="fa-solid fa-moon dark:hidden text-xs"></i>
          <i class="fa-solid fa-sun hidden dark:block text-[#D48D66] text-xs"></i>
        </button>
      </div>
    </header>

    <main class="p-4 sm:p-8 space-y-8 flex-1">

      <!-- SECTION 1: DRIVER VERIFICATION & BAN CHECKER -->
      <div class="clean-card p-6 sm:p-8 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-2xl shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-[#E1E2E4] dark:border-[#262A36]">
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#8C5137] dark:text-[#D48D66] flex items-center gap-1.5">
              <i class="fa-solid fa-shield-halved"></i> Applicant & Driver Verification
            </span>
            <h2 class="text-xl font-bold font-heading text-[#4A2B1D] dark:text-white mt-1">TruckersMP Player & Ban Lookup</h2>
          </div>
          <span class="text-xs px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20 self-start sm:self-auto">
            <i class="fa-solid fa-bolt mr-1"></i> Live Web API v2
          </span>
        </div>

        <!-- Search Input -->
        <form id="driver-lookup-form" class="flex flex-col sm:flex-row gap-3 max-w-2xl">
          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="driver-lookup-id" required placeholder="Enter SteamID64 (e.g. 7656119...) or TMP ID" class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-[#E1E2E4] dark:border-[#262A36] bg-white dark:bg-[#181B24] text-xs font-medium text-[#4A2B1D] dark:text-white focus:outline-none focus:border-[#8C5137]" />
          </div>
          <button type="submit" id="lookup-submit-btn" class="px-5 py-2.5 btn-primary text-xs font-bold rounded-xl shadow-xs flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-user-check"></i>
            <span>Inspect Driver</span>
          </button>
        </form>

        <!-- Search Results Container -->
        <div id="driver-result-container" class="mt-6 hidden">
          <!-- Dynamic Content rendered via JS -->
        </div>
      </div>

      <!-- SECTION 2: LIVE SIMULATION SERVERS -->
      <div class="clean-card p-6 sm:p-8 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-2xl shadow-sm">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#E1E2E4] dark:border-[#262A36]">
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#8C5137] dark:text-[#D48D66] flex items-center gap-1.5">
              <i class="fa-solid fa-server"></i> Fleet Operations
            </span>
            <h2 class="text-xl font-bold font-heading text-[#4A2B1D] dark:text-white mt-1">TruckersMP Server Status Monitor</h2>
          </div>
          <span class="text-xs text-[#8C5137] dark:text-slate-400 font-medium">Auto-synced</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% (typeof servers !== 'undefined' && Array.isArray(servers) ? servers : []).forEach(function(srv) { %>
            <% 
              const isOnline = srv.online;
              const percent = srv.maxplayers > 0 ? Math.round((srv.players / srv.maxplayers) * 100) : 0;
            %>
            <div class="p-4 rounded-xl border border-[#E1E2E4] dark:border-[#262A36] bg-[#F8F9FA] dark:bg-[#181B24] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold text-[#4A2B1D] dark:text-white truncate max-w-[180px]"><%= srv.name %></span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full font-bold <%= isOnline ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400' : 'bg-rose-500/15 text-rose-500' %>">
                    <%= isOnline ? 'Online' : 'Offline' %>
                  </span>
                </div>
                <div class="text-[11px] text-[#8C5137] dark:text-slate-400 space-y-1 mb-3">
                  <div class="flex justify-between">
                    <span>Game:</span>
                    <span class="font-semibold text-[#4A2B1D] dark:text-white"><%= srv.game %></span>
                  </div>
                  <div class="flex justify-between">
                    <span>Speed Limiter:</span>
                    <span class="font-semibold text-[#4A2B1D] dark:text-white"><%= srv.speedlimiter ? `${srv.speedlimiter} km/h` : 'Disabled' %></span>
                  </div>
                  <div class="flex justify-between">
                    <span>Collisions:</span>
                    <span class="font-semibold text-[#4A2B1D] dark:text-white"><%= srv.collisions ? 'Enabled' : 'Disabled' %></span>
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[11px] font-bold text-[#4A2B1D] dark:text-white mb-1">
                  <span>Players: <%= srv.players %> / <%= srv.maxplayers %></span>
                  <span><%= percent %>%</span>
                </div>
                <div class="w-full h-2 rounded-full bg-[#E1E2E4] dark:bg-[#262A36] overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-[#8C5137] to-[#D48D66] rounded-full" style="width: <%= percent %>%;"></div>
                </div>
                <% if (srv.queue > 0) { %>
                  <div class="mt-2 text-[10px] font-bold text-amber-500">
                    <i class="fa-solid fa-clock-rotate-left mr-1"></i> Queue: <%= srv.queue %> players
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

    </main>
  </div>

  <script>
    // Driver lookup form handler
    document.getElementById('driver-lookup-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('driver-lookup-id').value.trim();
      const btn = document.getElementById('lookup-submit-btn');
      const container = document.getElementById('driver-result-container');

      if (!id) return;

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Inspecting...</span>';
      container.classList.remove('hidden');
      container.innerHTML = `
        <div class="p-8 text-center text-xs text-slate-400">
          <i class="fa-solid fa-circle-notch fa-spin text-lg mb-2 text-[#8C5137]"></i>
          <p>Querying TruckersMP Web API v2 for Player & Ban Records...</p>
        </div>
      `;

      try {
        const res = await fetch(`/admin/api/truckersmp/search-driver?id=${encodeURIComponent(id)}`);
        const json = await res.json();

        if (!json.success || !json.player) {
          container.innerHTML = `
            <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs">
              <i class="fa-solid fa-triangle-exclamation mr-1.5"></i>
              <strong>Driver Not Found:</strong> Could not find any player matching "${id}". Please verify the SteamID64 or TruckersMP ID.
            </div>
          `;
          return;
        }

        const p = json.player;
        const bans = json.bans || [];
        const isBanned = bans.some(b => b.active);

        container.innerHTML = `
          <div class="p-5 rounded-2xl bg-[#F8F9FA] dark:bg-[#181B24] border border-[#E1E2E4] dark:border-[#262A36] space-y-6">
            
            <!-- Driver Header -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-[#E1E2E4] dark:border-[#262A36]">
              <div class="flex items-center gap-3">
                <img src="${p.avatar || 'https://truckersmp.com/assets/img/default-avatar.png'}" class="w-14 h-14 rounded-2xl object-cover border border-[#8C5137]/40 shadow-xs" />
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-[#4A2B1D] dark:text-white">${p.name}</h3>
                    <span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${isBanned ? 'bg-rose-500 text-white' : 'bg-emerald-500/20 text-emerald-500'}">
                      ${isBanned ? 'BANNED' : 'CLEAN RECORD'}
                    </span>
                  </div>
                  <div class="text-xs text-[#8C5137] dark:text-slate-400 flex flex-wrap gap-x-3 gap-y-1 mt-0.5">
                    <span>TMP ID: <strong>${p.id}</strong></span>
                    <span>SteamID64: <strong>${p.steamID64 || p.steamID || 'N/A'}</strong></span>
                  </div>
                </div>
              </div>
              <div class="text-right text-xs">
                <span class="text-slate-400 block text-[10px] uppercase">TMP Member Since</span>
                <span class="font-bold text-[#4A2B1D] dark:text-white">${p.joinDate ? new Date(p.joinDate).toLocaleDateString() : 'N/A'}</span>
              </div>
            </div>

            <!-- Profile Details Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36]">
                <span class="text-slate-400 text-[10px] block uppercase">VTC Group</span>
                <span class="font-bold text-[#4A2B1D] dark:text-white">${p.groupName || 'None'}</span>
              </div>
              <div class="p-3 rounded-xl bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36]">
                <span class="text-slate-400 text-[10px] block uppercase">Discord ID</span>
                <span class="font-bold text-[#4A2B1D] dark:text-white">${p.discordSnowflake || 'Not Linked'}</span>
              </div>
              <div class="p-3 rounded-xl bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36]">
                <span class="text-slate-400 text-[10px] block uppercase">Total Bans</span>
                <span class="font-bold ${bans.length > 0 ? 'text-rose-500' : 'text-emerald-500'}">${bans.length} Recorded</span>
              </div>
              <div class="p-3 rounded-xl bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36]">
                <span class="text-slate-400 text-[10px] block uppercase">VTC History</span>
                <span class="font-bold text-[#4A2B1D] dark:text-white">${p.displayVTCHistory ? 'Public' : 'Hidden'}</span>
              </div>
            </div>

            <!-- Bans History Table -->
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-[#8C5137] dark:text-[#D48D66] mb-2 flex items-center gap-1.5">
                <i class="fa-solid fa-gavel"></i> Ban History (${bans.length})
              </h4>
              ${bans.length === 0 ? `
                <div class="p-4 rounded-xl bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] text-xs text-emerald-600 dark:text-emerald-400 font-medium">
                  <i class="fa-solid fa-circle-check mr-1.5"></i> No active or historical bans found for this player.
                </div>
              ` : `
                <div class="space-y-2">
                  ${bans.map(b => `
                    <div class="p-3 rounded-xl bg-white dark:bg-[#13161D] border ${b.active ? 'border-rose-500/50 bg-rose-500/5' : 'border-[#E1E2E4] dark:border-[#262A36]'} text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <div>
                        <div class="flex items-center gap-2 mb-1">
                          <span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${b.active ? 'bg-rose-500 text-white' : 'bg-slate-500/20 text-slate-400'}">
                            ${b.active ? 'ACTIVE BAN' : 'EXPIRED'}
                          </span>
                          <span class="font-bold text-[#4A2B1D] dark:text-white">${b.reason || 'No reason provided'}</span>
                        </div>
                        <div class="text-[11px] text-slate-400">
                          Issued: ${b.timeAdded ? new Date(b.timeAdded).toLocaleDateString() : '—'} by Admin: ${b.adminName || 'Staff'}
                        </div>
                      </div>
                      <div class="text-right text-[11px] text-slate-400">
                        Expires: <strong class="text-[#4A2B1D] dark:text-white">${b.expires ? new Date(b.expires).toLocaleString() : 'Permanent'}</strong>
                      </div>
                    </div>
                  `).join('')}
                </div>
              `}
            </div>

          </div>
        `;

      } catch (err) {
        container.innerHTML = `
          <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs">
            <i class="fa-solid fa-circle-xmark mr-1.5"></i> Error querying API: ${err.message}
          </div>
        `;
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-user-check"></i><span>Inspect Driver</span>';
      }
    });

    // Mobile Sidebar toggle
    const sidebar = document.getElementById('admin-sidebar');
    const overlay = document.getElementById('admin-sidebar-overlay');
    const openBtn = document.getElementById('open-admin-sidebar-btn');
    const closeBtn = document.getElementById('close-admin-sidebar-btn');

    if (openBtn && sidebar) {
      openBtn.addEventListener('click', () => {
        sidebar.classList.remove('-translate-x-full');
        if (overlay) overlay.classList.remove('hidden');
      });
    }
    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', () => {
        sidebar.classList.add('-translate-x-full');
        if (overlay) overlay.classList.add('hidden');
      });
    }
    if (overlay && sidebar) {
      overlay.addEventListener('click', () => {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
      });
    }
  </script>

  <%- include('../partials/scripts') %>
</body>
</html>
