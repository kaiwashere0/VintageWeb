<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#000000] text-[#4A2B1D] dark:text-[#FFFFFF]">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Admin Portal — Vintage Club' %></title>
  <link rel="icon" type="image/png" href="/Wintage_Club_Logo_2050.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/output.css">
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>

<body class="min-h-full bg-[#FFFFFF] dark:bg-[#000000] text-[#4A2B1D] dark:text-[#FFFFFF] flex">

  <!-- ADMIN SIDEBAR -->
  <%- include('partials/sidebar') %>

  <!-- MAIN VIEWPORT WRAPPER (Offset by sidebar width on lg) -->
  <div class="flex-1 lg:pl-64 flex flex-col min-h-screen">
    
    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-30 bg-white/80 dark:bg-[#120B07]/80 backdrop-blur-md border-b border-[#E1E2E4] dark:border-[#4A2B1D] px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between transition-all duration-300">
      
      <!-- Left: Mobile Toggle & Breadcrumb -->
      <div class="flex items-center gap-3">
        <button id="open-admin-sidebar-btn" type="button" class="lg:hidden w-9 h-9 rounded-xl bg-[#E1E2E4]/60 dark:bg-[#20130C] text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4] dark:hover:bg-[#301C12] transition-colors flex items-center justify-center cursor-pointer" aria-label="Open Menu">
          <i class="fa-solid fa-bars-staggered text-sm"></i>
        </button>
        <div>
          <h1 class="font-heading font-extrabold text-base sm:text-lg text-[#4A2B1D] dark:text-white tracking-tight flex items-center gap-2">
            <span>Admin Portal</span>
            <span class="text-xs text-[#8C5137] dark:text-[#AA6343] font-normal">/ Overview</span>
          </h1>
        </div>
      </div>

      <!-- Right: Theme Toggle & User Info -->
      <div class="flex items-center gap-3">
        
        <!-- Theme Toggle -->
        <button type="button" class="theme-toggle-btn w-9 h-9 rounded-xl border border-[#E1E2E4] dark:border-[#4A2B1D] bg-white dark:bg-[#18100B] text-[#8C5137] dark:text-[#E1E2E4] hover:bg-[#E1E2E4]/50 dark:hover:bg-[#20130C] hover:scale-105 active:scale-95 transition-all flex items-center justify-center cursor-pointer" title="Toggle Theme">
          <i class="fa-solid fa-moon dark:hidden text-xs"></i>
          <i class="fa-solid fa-sun hidden dark:block text-[#AA6343] text-xs"></i>
        </button>

        <!-- User Quick Profile Button -->
        <div class="flex items-center gap-2 pl-2 border-l border-[#E1E2E4] dark:border-[#4A2B1D]">
          <img src="<%= (typeof user !== 'undefined' && user?.avatarUrl) ? user.avatarUrl : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" class="w-8 h-8 rounded-full object-cover border border-[#8C5137]/50 shadow-xs transition-transform hover:scale-110" />
          <span class="hidden md:inline text-xs font-bold text-[#4A2B1D] dark:text-white max-w-[120px] truncate">
            <%= (typeof user !== 'undefined' && (user?.globalName || user?.username)) ? (user.globalName || user.username) : 'Admin' %>
          </span>
        </div>

      </div>
    </header>

    <!-- MAIN DASHBOARD CONTENT -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-8 max-w-7xl w-full mx-auto">

      <!-- WELCOME HERO BANNER -->
      <div class="relative overflow-hidden clean-card p-6 sm:p-8 bg-gradient-to-r from-[#4A2B1D] to-[#8C5137] text-white border-0 shadow-xl animate-fade-in-up hover-lift">
        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-sm text-[11px] font-bold uppercase tracking-wider mb-3 animate-pulse-gentle">
            <i class="fa-solid fa-shield-halved"></i> Management Portal
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading tracking-tight mb-2">
            Welcome, <%= (typeof user !== 'undefined' && (user?.globalName || user?.username)) ? (user.globalName || user.username) : 'Administrator' %>!
          </h2>
          <p class="text-xs sm:text-sm text-white/85 leading-relaxed">
            You are signed in to the Vintage Club Administration Portal. Manage driver applications, events, and system operations from this dashboard.
          </p>
        </div>
        <!-- Decorative Ambient Icon -->
        <div class="absolute -right-8 -bottom-8 opacity-10 text-white text-[160px] pointer-events-none select-none transition-transform duration-700 hover:scale-110 animate-float-gentle">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
      </div>

      <!-- 4 KEY METRICS CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        
        <!-- Metric 1: Applications -->
        <div class="clean-card p-6 bg-white dark:bg-[#120B07] hover-lift hover-glow animate-fade-in-up delay-75 group">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#AA6343] uppercase tracking-wider">Applications</span>
            <div class="w-10 h-10 rounded-xl bg-[#8C5137]/10 flex items-center justify-center text-[#8C5137] dark:text-[#AA6343] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
              <i class="fa-solid fa-file-signature text-base"></i>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
              <%= (typeof stats !== 'undefined') ? stats.applicationsCount : 0 %>
            </span>
            <a href="/admin/applications" class="text-xs font-semibold text-[#8C5137] dark:text-[#AA6343] hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>View All</span> <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>

        <!-- Metric 2: Events -->
        <div class="clean-card p-6 bg-white dark:bg-[#120B07] hover-lift hover-glow animate-fade-in-up delay-150 group">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#AA6343] uppercase tracking-wider">Convoys & Events</span>
            <div class="w-10 h-10 rounded-xl bg-[#8C5137]/10 flex items-center justify-center text-[#8C5137] dark:text-[#AA6343] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
              <i class="fa-solid fa-truck-moving text-base"></i>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
              <%= (typeof stats !== 'undefined') ? stats.eventsCount : 0 %>
            </span>
            <a href="/events" target="_blank" class="text-xs font-semibold text-[#8C5137] dark:text-[#AA6343] hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>Live Page</span> <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>
        </div>

        <!-- Metric 3: Members -->
        <div class="clean-card p-6 bg-white dark:bg-[#120B07] hover-lift hover-glow animate-fade-in-up delay-200 group">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#AA6343] uppercase tracking-wider">Registered Drivers</span>
            <div class="w-10 h-10 rounded-xl bg-[#8C5137]/10 flex items-center justify-center text-[#8C5137] dark:text-[#AA6343] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
              <i class="fa-solid fa-id-badge text-base"></i>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
              <%= (typeof stats !== 'undefined') ? stats.membersCount : 0 %>
            </span>
            <a href="/team" target="_blank" class="text-xs font-semibold text-[#8C5137] dark:text-[#AA6343] hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>Roster</span> <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>
        </div>

        <!-- Metric 4: Media Gallery -->
        <div class="clean-card p-6 bg-white dark:bg-[#120B07] hover-lift hover-glow animate-fade-in-up delay-300 group">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#8C5137] dark:text-[#AA6343] uppercase tracking-wider">Media Gallery</span>
            <div class="w-10 h-10 rounded-xl bg-[#8C5137]/10 flex items-center justify-center text-[#8C5137] dark:text-[#AA6343] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
              <i class="fa-solid fa-camera-retro text-base"></i>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
              <%= (typeof stats !== 'undefined') ? stats.galleryCount : 0 %>
            </span>
            <a href="/gallery" target="_blank" class="text-xs font-semibold text-[#8C5137] dark:text-[#AA6343] hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>Gallery</span> <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>
        </div>

      </div>

      <!-- TWO-COLUMN CONTENT GRID -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left: Recent Applications Table -->
        <div class="lg:col-span-2 clean-card p-6 bg-white dark:bg-[#120B07] hover-glow transition-all duration-300 animate-fade-in-up delay-200">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#E1E2E4] dark:border-[#4A2B1D]">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-[#8C5137]/10 text-[#8C5137] dark:text-[#AA6343] flex items-center justify-center">
                <i class="fa-solid fa-inbox text-sm"></i>
              </div>
              <div>
                <h3 class="font-heading font-bold text-base text-[#4A2B1D] dark:text-white">
                  Recent Driver Applications
                </h3>
                <p class="text-xs text-[#8C5137] dark:text-[#E1E2E4]/80">Latest applications submitted through the website</p>
              </div>
            </div>
            <a href="/admin/applications" class="text-xs font-bold text-[#8C5137] dark:text-[#AA6343] hover:underline">
              View All
            </a>
          </div>

          <% if (typeof recentApplications !== 'undefined' && recentApplications && recentApplications.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="border-b border-[#E1E2E4] dark:border-[#4A2B1D] text-[#8C5137] dark:text-[#AA6343] uppercase tracking-wider">
                    <th class="py-2.5 px-3">Driver Name</th>
                    <th class="py-2.5 px-3">Discord</th>
                    <th class="py-2.5 px-3">TMP Profile</th>
                    <th class="py-2.5 px-3">Status</th>
                    <th class="py-2.5 px-3">Date</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#E1E2E4] dark:divide-[#4A2B1D]/40">
                  <% recentApplications.forEach(app => { %>
                    <tr class="hover:bg-[#E1E2E4]/30 dark:hover:bg-[#1A100A] transition-all duration-150 group">
                      <td class="py-3 px-3 font-semibold text-[#4A2B1D] dark:text-white group-hover:translate-x-0.5 transition-transform"><%= app.fullName %></td>
                      <td class="py-3 px-3 text-[#8C5137] dark:text-[#E1E2E4]"><%= app.discordTag %></td>
                      <td class="py-3 px-3">
                        <a href="<%= app.truckersMpProfile %>" target="_blank" rel="noopener" class="text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1">
                          <span>TMP</span> <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                        </a>
                      </td>
                      <td class="py-3 px-3">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold inline-flex items-center gap-1 <%= app.status === 'approved' ? 'bg-emerald-500/10 text-emerald-600' : (app.status === 'rejected' ? 'bg-rose-500/10 text-rose-600' : 'bg-amber-500/10 text-amber-600') %>">
                          <span class="w-1.5 h-1.5 rounded-full <%= app.status === 'approved' ? 'bg-emerald-500' : (app.status === 'rejected' ? 'bg-rose-500' : 'bg-amber-500') %>"></span>
                          <%= app.status === 'approved' ? 'Approved' : (app.status === 'rejected' ? 'Rejected' : 'Pending') %>
                        </span>
                      </td>
                      <td class="py-3 px-3 text-[#8C5137] dark:text-[#E1E2E4]/70 text-[11px]">
                        <%= app.createdAt ? new Date(app.createdAt).toLocaleDateString('en-US') : 'Today' %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="py-12 text-center text-[#8C5137] dark:text-[#E1E2E4]/70">
              <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-[#E1E2E4]/50 dark:bg-[#1A100A] flex items-center justify-center text-[#8C5137] dark:text-[#AA6343] text-xl">
                <i class="fa-solid fa-inbox"></i>
              </div>
              <p class="text-xs font-semibold">No driver applications received yet.</p>
              <p class="text-[11px] mt-1">Submitted applications will be listed here automatically.</p>
            </div>
          <% } %>
        </div>

        <!-- Right: Quick Operations & Official Channels -->
        <div class="space-y-6">
          
          <!-- Quick Operations -->
          <div class="clean-card p-6 bg-white dark:bg-[#120B07] hover-glow transition-all duration-300 animate-fade-in-up delay-200">
            <div class="flex items-center gap-3 mb-4 pb-3 border-b border-[#E1E2E4] dark:border-[#4A2B1D]">
              <div class="w-8 h-8 rounded-xl bg-[#8C5137]/10 text-[#8C5137] dark:text-[#AA6343] flex items-center justify-center text-sm">
                <i class="fa-solid fa-bolt"></i>
              </div>
              <h4 class="font-heading font-bold text-sm text-[#4A2B1D] dark:text-white">
                Quick Operations
              </h4>
            </div>
            <div class="space-y-2">
              <a href="/apply" target="_blank" class="flex items-center justify-between p-3 rounded-xl bg-[#E1E2E4]/40 dark:bg-[#1A100A] hover:bg-[#E1E2E4] dark:hover:bg-[#20130C] text-xs font-semibold text-[#4A2B1D] dark:text-white transition-all duration-200 group hover:translate-x-1">
                <span class="flex items-center gap-2.5">
                  <i class="fa-solid fa-paper-plane text-[#8C5137] dark:text-[#AA6343] transition-transform group-hover:scale-110"></i>
                  <span>Test Driver Form</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
              </a>
              <a href="/events" target="_blank" class="flex items-center justify-between p-3 rounded-xl bg-[#E1E2E4]/40 dark:bg-[#1A100A] hover:bg-[#E1E2E4] dark:hover:bg-[#20130C] text-xs font-semibold text-[#4A2B1D] dark:text-white transition-all duration-200 group hover:translate-x-1">
                <span class="flex items-center gap-2.5">
                  <i class="fa-solid fa-calendar-days text-[#8C5137] dark:text-[#AA6343] transition-transform group-hover:scale-110"></i>
                  <span>Convoy Schedule</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
              </a>
              <a href="/" target="_blank" class="flex items-center justify-between p-3 rounded-xl bg-[#E1E2E4]/40 dark:bg-[#1A100A] hover:bg-[#E1E2E4] dark:hover:bg-[#20130C] text-xs font-semibold text-[#4A2B1D] dark:text-white transition-all duration-200 group hover:translate-x-1">
                <span class="flex items-center gap-2.5">
                  <i class="fa-solid fa-globe text-[#8C5137] dark:text-[#AA6343] transition-transform group-hover:scale-110"></i>
                  <span>Open Homepage</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
              </a>
            </div>
          </div>

          <!-- Official Channels & Community -->
          <div class="clean-card p-6 bg-white dark:bg-[#120B07] hover-glow transition-all duration-300 animate-fade-in-up delay-300">
            <div class="flex items-center gap-3 mb-4 pb-3 border-b border-[#E1E2E4] dark:border-[#4A2B1D]">
              <div class="w-8 h-8 rounded-xl bg-[#8C5137]/10 text-[#8C5137] dark:text-[#AA6343] flex items-center justify-center text-sm">
                <i class="fa-solid fa-share-nodes"></i>
              </div>
              <h4 class="font-heading font-bold text-sm text-[#4A2B1D] dark:text-white">
                Official Channels
              </h4>
            </div>
            <div class="space-y-2">
              <a href="https://truckersmp.com/vtc/80136" target="_blank" rel="noopener" class="flex items-center justify-between p-2.5 rounded-xl bg-[#E1E2E4]/30 dark:bg-[#1A100A] hover:bg-[#E1E2E4]/60 dark:hover:bg-[#20130C] text-xs text-[#8C5137] dark:text-[#E1E2E4] hover:text-[#4A2B1D] dark:hover:text-white transition-all group hover:translate-x-1">
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-truck-fast text-[#8C5137] dark:text-[#AA6343]"></i>
                  <span class="font-medium">TruckersMP VTC #80136</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5"></i>
              </a>
              <a href="https://discord.com/invite/vintageclub" target="_blank" rel="noopener" class="flex items-center justify-between p-2.5 rounded-xl bg-[#E1E2E4]/30 dark:bg-[#1A100A] hover:bg-[#E1E2E4]/60 dark:hover:bg-[#20130C] text-xs text-[#8C5137] dark:text-[#E1E2E4] hover:text-[#4A2B1D] dark:hover:text-white transition-all group hover:translate-x-1">
                <span class="flex items-center gap-2">
                  <i class="fa-brands fa-discord text-indigo-500"></i>
                  <span class="font-medium">Discord Server</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5"></i>
              </a>
              <a href="https://www.instagram.com/vintageclubofficiall?stkn=MXNmcnY5cDYweTJ6cQ%3D%3D&utm_source=qr" target="_blank" rel="noopener" class="flex items-center justify-between p-2.5 rounded-xl bg-[#E1E2E4]/30 dark:bg-[#1A100A] hover:bg-[#E1E2E4]/60 dark:hover:bg-[#20130C] text-xs text-[#8C5137] dark:text-[#E1E2E4] hover:text-[#4A2B1D] dark:hover:text-white transition-all group hover:translate-x-1">
                <span class="flex items-center gap-2">
                  <i class="fa-brands fa-instagram text-pink-600"></i>
                  <span class="font-medium">Instagram</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5"></i>
              </a>
              <a href="https://www.youtube.com/@VntgClub" target="_blank" rel="noopener" class="flex items-center justify-between p-2.5 rounded-xl bg-[#E1E2E4]/30 dark:bg-[#1A100A] hover:bg-[#E1E2E4]/60 dark:hover:bg-[#20130C] text-xs text-[#8C5137] dark:text-[#E1E2E4] hover:text-[#4A2B1D] dark:hover:text-white transition-all group hover:translate-x-1">
                <span class="flex items-center gap-2">
                  <i class="fa-brands fa-youtube text-red-500"></i>
                  <span class="font-medium">YouTube</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-60 transition-transform group-hover:translate-x-0.5"></i>
              </a>
            </div>
          </div>

        </div>

      </div>

    </main>

  </div>

  <script>
    // Admin Responsive Sidebar Controller
    const sidebar = document.getElementById('admin-sidebar');
    const overlay = document.getElementById('admin-sidebar-overlay');
    const openBtn = document.getElementById('open-admin-sidebar-btn');
    const closeBtn = document.getElementById('close-admin-sidebar-btn');

    if (openBtn && sidebar && overlay) {
      openBtn.addEventListener('click', () => {
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
      });

      const closeSidebar = () => {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
      };

      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      overlay.addEventListener('click', closeSidebar);
    }

    // Theme Toggle for Admin
    document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const nextTheme = isDark ? 'light' : 'dark';
        if (nextTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        localStorage.setItem('theme', nextTheme);
      });
    });
  </script>

</body>
</html>

