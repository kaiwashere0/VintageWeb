<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#000000] text-[#4A2B1D] dark:text-[#FFFFFF]">

<%- include('partials/head', { 
  title: 'Our Team — Vintage Club',
  description: 'Vintage Club leadership, convoy control staff, and verified drivers.' 
}) %>

<body class="min-h-full flex flex-col justify-between bg-[#FFFFFF] dark:bg-[#000000] text-[#4A2B1D] dark:text-[#FFFFFF] selection:bg-[#8C5137] selection:text-white transition-colors duration-300">

  <!-- NAVBAR PARTIAL -->
  <%- include('partials/navbar', { currentPath: '/team' }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-grow py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-[#8C5137] dark:text-[#AA6343] text-xs font-bold uppercase tracking-wider mb-2 flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-users"></i> Club Roster
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading text-[#4A2B1D] dark:text-white tracking-tight">
        Our Team & Roster
      </h1>
      <p class="text-[#8C5137] dark:text-[#E1E2E4] text-sm sm:text-base mt-4">
        Founded by <strong class="text-[#4A2B1D] dark:text-white">nasriemir.</strong> — meet the administration, convoy leaders, and drivers of Vintage Club.
      </p>
    </div>

    <div id="team-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Dynamic team members loaded by /js/app.js -->
    </div>
  </main>

  <!-- FOOTER PARTIAL -->
  <%- include('partials/footer') %>

  <!-- SCRIPTS PARTIAL -->
  <%- include('partials/scripts') %>

</body>
</html>
