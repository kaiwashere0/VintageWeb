<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF]">

<%- include('partials/head', { 
  title: 'Vintage Club — ' + t('hero.title_line1', 'Nobility on Roads'),
  description: t('hero.subtitle', 'Vintage Club is an elite simulation convoy community built for passion, discipline, and unforgettable logistics experiences on European highways.') 
}) %>

<body class="min-h-full flex flex-col justify-between bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF] selection:bg-[#8C5137] selection:text-white transition-colors duration-300">

  <!-- NAVBAR PARTIAL (Essential Links Only) -->
  <%- include('partials/navbar', { currentPath: '/' }) %>

  <!-- 2. HERO SECTION WITH CINEMATIC BANNER & SEAMLESS FADE -->
  <section class="relative pt-16 pb-24 sm:pt-24 sm:pb-32 px-4 sm:px-6 lg:px-8 border-b border-[#E1E2E4] dark:border-[#262A36] flex flex-col items-center justify-center text-center overflow-hidden">
    
    <!-- Hero Background Banner Layer with Smooth Downward Gradient Fade -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
      <img src="/VTC_Memeber_Bio_Signature.png" alt="Vintage Club Convoy Banner" class="w-full h-full object-cover object-top opacity-60 dark:opacity-50 scale-105 transform transition-transform duration-1000" />
      
      <!-- Top Vignette & Subtle Center Tint for text readability -->
      <div class="absolute inset-0 bg-radial from-transparent via-black/20 to-black/60 dark:via-black/40 dark:to-black/80"></div>
      
      <!-- Silky Smooth Downward Gradient Fade into Page Background -->
      <div class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/70 to-[#FFFFFF] dark:from-[#0C0D11]/30 dark:via-[#0C0D11]/75 dark:to-[#0C0D11]"></div>
      <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#FFFFFF] dark:from-[#0C0D11] via-[#FFFFFF]/90 dark:via-[#0C0D11]/90 to-transparent"></div>
    </div>

    <!-- Hero Content Layer -->
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      
      <!-- Live Status Capsule Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/80 dark:bg-[#181B24]/80 border border-[#8C5137]/30 text-xs font-semibold text-[#8C5137] dark:text-[#D48D66] mb-6 shadow-sm backdrop-blur-md animate-fade-in-up">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wide">TruckersMP VTC #80136 • 2026 Fleet Active</span>
      </div>

      <!-- Brand Logo with Gentle Floating Motion -->
      <div class="mb-6 sm:mb-8 transition-transform duration-300 hover:scale-105 animate-fade-in-scale">
        <img src="/Wintage_Club_Logo_2050.png" alt="Vintage Club Logo" class="h-32 sm:h-40 md:h-48 w-auto object-contain drop-shadow-2xl mx-auto animate-float-gentle" />
      </div>

      <!-- Main Dual-Tone Headline -->
      <h1 class="font-heading text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight max-w-3xl animate-fade-in-up">
        <span class="text-[#4A2B1D] dark:text-white block"><%= t('hero.title_line1', 'Nobility on the Roads') %></span>
        <span class="bg-gradient-to-r from-[#8C5137] via-[#D48D66] to-[#E5A882] bg-clip-text text-transparent block mt-1"><%= t('hero.title_line2', 'Power in the Convoy') %></span>
      </h1>

      <p class="text-[#4A2B1D] dark:text-slate-200 text-sm sm:text-base md:text-lg max-w-2xl font-normal mb-10 leading-relaxed drop-shadow-xs animate-fade-in-up delay-100">
        <%= t('hero.subtitle', 'Vintage Club is an elite simulation convoy community built for passion, discipline, and unforgettable logistics experiences on European highways.') %>
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center gap-3.5 w-full sm:w-auto animate-fade-in-up delay-200">
        <a href="/apply" class="w-full sm:w-auto px-8 py-3.5 btn-primary text-xs sm:text-sm font-bold rounded-xl shadow-lg gap-2 flex items-center justify-center">
          <i class="fa-solid fa-paper-plane text-xs"></i>
          <span><%= t('hero.btn_apply', 'Join Our Fleet') %></span>
        </a>
        <a href="/events" class="w-full sm:w-auto px-8 py-3.5 btn-secondary text-xs sm:text-sm font-bold rounded-xl backdrop-blur-md gap-2 flex items-center justify-center">
          <i class="fa-solid fa-calendar-days text-xs text-[#8C5137] dark:text-[#D48D66]"></i>
          <span><%= t('hero.btn_explore', 'Explore Convoys') %></span>
        </a>
      </div>

      <!-- Glassmorphic Live Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 w-full max-w-4xl mt-16 reveal-on-scroll">
        <div class="clean-card p-5 text-center hover-lift hover-glow backdrop-blur-xl bg-white/80 dark:bg-[#13161D]/80 border border-[#E1E2E4] dark:border-[#262A36] shadow-md">
          <div class="text-[#8C5137] dark:text-[#D48D66] mb-1.5 text-lg"><i class="fa-solid fa-users"></i></div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white" id="stat-members">0</span>
          <span class="text-[11px] sm:text-xs uppercase tracking-wider text-[#8C5137] dark:text-slate-400 font-semibold mt-1"><%= t('stats.members', 'Active Drivers') %></span>
        </div>
        <div class="clean-card p-5 text-center hover-lift hover-glow delay-100 backdrop-blur-xl bg-white/80 dark:bg-[#13161D]/80 border border-[#E1E2E4] dark:border-[#262A36] shadow-md">
          <div class="text-[#8C5137] dark:text-[#D48D66] mb-1.5 text-lg"><i class="fa-solid fa-flag-checkered"></i></div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white" id="stat-convoys">0</span>
          <span class="text-[11px] sm:text-xs uppercase tracking-wider text-[#8C5137] dark:text-slate-400 font-semibold mt-1"><%= t('stats.convoys', 'Completed Convoys') %></span>
        </div>
        <div class="clean-card p-5 text-center hover-lift hover-glow delay-200 backdrop-blur-xl bg-white/80 dark:bg-[#13161D]/80 border border-[#E1E2E4] dark:border-[#262A36] shadow-md">
          <div class="text-[#8C5137] dark:text-[#D48D66] mb-1.5 text-lg"><i class="fa-solid fa-road"></i></div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white" id="stat-km">0 KM</span>
          <span class="text-[11px] sm:text-xs uppercase tracking-wider text-[#8C5137] dark:text-slate-400 font-semibold mt-1"><%= t('stats.km', 'Total Distance') %></span>
        </div>
        <div class="clean-card p-5 text-center hover-lift hover-glow delay-300 backdrop-blur-xl bg-white/80 dark:bg-[#13161D]/80 border border-[#E1E2E4] dark:border-[#262A36] shadow-md">
          <div class="text-[#8C5137] dark:text-[#D48D66] mb-1.5 text-lg"><i class="fa-solid fa-clock-rotate-left"></i></div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white" id="stat-founded">2024</span>
          <span class="text-[11px] sm:text-xs uppercase tracking-wider text-[#8C5137] dark:text-slate-400 font-semibold mt-1"><%= t('stats.founded', 'Established') %></span>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. HERITAGE & PHILOSOPHY SECTION -->
  <section id="about" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12 reveal-on-scroll">
      <div class="text-[#8C5137] dark:text-[#D48D66] text-xs font-bold uppercase tracking-wider mb-2 flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-building-columns"></i> <%= t('about.hero_title', 'Heritage & Philosophy') %>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-[#4A2B1D] dark:text-white tracking-tight mb-4">
        <%= t('home.about_title', 'Who is Vintage Club?') %>
      </h2>
      <p class="text-[#8C5137] dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        <%= t('home.about_desc', 'Founded with a vision of realistic driving aesthetics and convoy discipline, Vintage Club delivers the premier European virtual trucking experience.') %>
      </p>
    </div>

    <!-- Feature Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="clean-card p-6 reveal-on-scroll delay-100 hover-lift hover-glow">
        <div class="w-11 h-11 rounded-xl bg-[#8C5137]/10 dark:bg-[#D48D66]/10 border border-[#8C5137]/20 dark:border-[#D48D66]/20 flex items-center justify-center text-[#8C5137] dark:text-[#D48D66] text-lg mb-4">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h3 class="font-bold font-heading text-[#4A2B1D] dark:text-white text-base mb-2"><%= t('home.feature_1_title', 'Convoy Discipline') %></h3>
        <p class="text-xs text-[#8C5137] dark:text-slate-400 leading-relaxed">
          <%= t('home.feature_1_desc', 'Synchronized radio communications, strict distance keeping, and designated pilot escorts.') %>
        </p>
      </div>

      <div class="clean-card p-6 reveal-on-scroll delay-200 hover-lift hover-glow">
        <div class="w-11 h-11 rounded-xl bg-[#8C5137]/10 dark:bg-[#D48D66]/10 border border-[#8C5137]/20 dark:border-[#D48D66]/20 flex items-center justify-center text-[#8C5137] dark:text-[#D48D66] text-lg mb-4">
          <i class="fa-solid fa-handshake-angle"></i>
        </div>
        <h3 class="font-bold font-heading text-[#4A2B1D] dark:text-white text-base mb-2"><%= t('home.feature_3_title', 'Active Community') %></h3>
        <p class="text-xs text-[#8C5137] dark:text-slate-400 leading-relaxed">
          <%= t('home.feature_3_desc', 'Weekly international convoys, voice channels, and driver ranking progression.') %>
        </p>
      </div>

      <div class="clean-card p-6 reveal-on-scroll delay-300 hover-lift hover-glow">
        <div class="w-11 h-11 rounded-xl bg-[#8C5137]/10 dark:bg-[#D48D66]/10 border border-[#8C5137]/20 dark:border-[#D48D66]/20 flex items-center justify-center text-[#8C5137] dark:text-[#D48D66] text-lg mb-4">
          <i class="fa-solid fa-truck-front"></i>
        </div>
        <h3 class="font-bold font-heading text-[#4A2B1D] dark:text-white text-base mb-2"><%= t('home.feature_2_title', 'Exclusive Liveries') %></h3>
        <p class="text-xs text-[#8C5137] dark:text-slate-400 leading-relaxed">
          <%= t('home.feature_2_desc', 'Signature warm copper and black custom truck designs tailored for convoy elegance.') %>
        </p>
      </div>
    </div>

    <div class="text-center reveal-on-scroll delay-200">
      <a href="/about" class="inline-flex items-center gap-2 text-xs font-semibold text-[#8C5137] dark:text-[#D48D66] hover:underline">
        <span><%= t('home.read_more', 'Learn More') %></span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>
  </section>

  <!-- 4. OUR TEAM SECTION -->
  <section id="team" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-[#E1E2E4]/40 dark:bg-[#13161D] border-y border-[#E1E2E4] dark:border-[#262A36]">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 reveal-on-scroll">
        <div>
          <div class="text-[#8C5137] dark:text-[#D48D66] text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-user-group"></i> <%= t('team.hero_title', 'Fleet Roster') %>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-[#4A2B1D] dark:text-white tracking-tight">
            <%= t('nav.team', 'Roster') %>
          </h2>
          <p class="text-[#8C5137] dark:text-slate-400 text-sm mt-1"><%= t('team.hero_subtitle', 'Meet the founders, management team, and dedicated drivers driving Vintage Club forward.') %></p>
        </div>
        <a href="/team" class="mt-4 md:mt-0 text-xs font-bold text-[#4A2B1D] dark:text-white hover:text-[#8C5137] dark:hover:text-[#D48D66] flex items-center gap-1.5 transition-colors">
          <%= t('team.filter_all', 'Full Team Roster') %> <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div id="team-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Backend dynamic items from MongoDB -->
      </div>
    </div>
  </section>

  <!-- 5. OUR EVENTS SECTION -->
  <section id="events" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 reveal-on-scroll">
      <div>
        <div class="text-[#8C5137] dark:text-[#D48D66] text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <i class="fa-solid fa-calendar-check"></i> <%= t('events.hero_title', 'Convoy Schedule') %>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-[#4A2B1D] dark:text-white tracking-tight">
          <%= t('home.events_title', 'Scheduled Convoys') %>
        </h2>
        <p class="text-[#8C5137] dark:text-slate-400 text-sm mt-1"><%= t('home.events_subtitle', 'Next Convoy Departures & Operations') %></p>
      </div>
      <a href="/events" class="mt-4 md:mt-0 text-xs font-bold text-[#4A2B1D] dark:text-white hover:text-[#8C5137] dark:hover:text-[#D48D66] flex items-center gap-1.5 transition-colors">
        <%= t('home.view_all_events', 'View All Convoys') %> <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>

    <div id="events-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Backend dynamic items from MongoDB -->
    </div>
  </section>

  <!-- 6. GALLERY SECTION -->
  <section id="gallery" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-[#E1E2E4]/40 dark:bg-[#13161D] border-t border-[#E1E2E4] dark:border-[#262A36]">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 reveal-on-scroll">
        <div>
          <div class="text-[#8C5137] dark:text-[#D48D66] text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-images"></i> <%= t('gallery.hero_title', 'Cinematic Gallery') %>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-[#4A2B1D] dark:text-white tracking-tight">
            <%= t('home.gallery_title', 'Convoy Moments') %>
          </h2>
          <p class="text-[#8C5137] dark:text-slate-400 text-sm mt-1"><%= t('home.gallery_subtitle', 'Cinematic Road Photography') %></p>
        </div>
        <a href="/gallery" class="mt-4 md:mt-0 text-xs font-bold text-[#4A2B1D] dark:text-white hover:text-[#8C5137] dark:hover:text-[#D48D66] flex items-center gap-1.5 transition-colors">
          <%= t('home.view_all_gallery', 'Open Full Gallery') %> <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div id="gallery-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Backend dynamic items from MongoDB -->
      </div>
    </div>
  </section>

  <!-- FOOTER PARTIAL -->
  <%- include('partials/footer') %>

  <!-- SCRIPTS PARTIAL -->
  <%- include('partials/scripts') %>

</body>

</html>
