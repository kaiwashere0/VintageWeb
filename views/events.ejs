<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF]">

<%- include('partials/head', { 
  title: t('events.page_title', 'Convoys & Events — Vintage Club Schedule'),
  description: t('events.hero_subtitle', 'Discover upcoming official convoys, public runs, and multi-VTC joint events.') 
}) %>

<body class="min-h-full flex flex-col justify-between bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF] selection:bg-[#8C5137] selection:text-white transition-colors duration-300">

  <!-- NAVBAR PARTIAL -->
  <%- include('partials/navbar', { currentPath: '/events' }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-grow py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-[#8C5137] dark:text-[#D48D66] text-xs font-bold uppercase tracking-wider mb-2 flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-calendar-days"></i> <%= t('events.hero_title', 'CONVOY SCHEDULE') %>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading text-[#4A2B1D] dark:text-white tracking-tight">
        <%= t('home.events_title', 'Scheduled Convoys') %>
      </h1>
      <p class="text-[#8C5137] dark:text-slate-300 text-sm sm:text-base mt-4">
        <%= t('events.hero_subtitle', 'Discover upcoming official convoys, public runs, and multi-VTC joint events.') %>
      </p>
    </div>

    <div id="events-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Dynamic events loaded by /js/app.js -->
    </div>
  </main>

  <!-- FOOTER PARTIAL -->
  <%- include('partials/footer') %>

  <!-- SCRIPTS PARTIAL -->
  <%- include('partials/scripts') %>

</body>
</html>
