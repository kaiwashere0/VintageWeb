<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF]">

<%- include('partials/head', { 
  title: 'Driver Recruitment — Vintage Club',
  description: 'Vintage Club driver application and membership form.' 
}) %>

<body class="min-h-full flex flex-col justify-between bg-[#FFFFFF] dark:bg-[#0C0D11] text-[#4A2B1D] dark:text-[#FFFFFF] selection:bg-[#8C5137] selection:text-white transition-colors duration-300">

  <!-- NAVBAR PARTIAL -->
  <%- include('partials/navbar', { currentPath: '/apply' }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-grow py-16 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto w-full">
    <div class="clean-card p-8 sm:p-10 shadow-sm bg-white dark:bg-[#181B24] border-[#E1E2E4] dark:border-[#262A36]">
      <div class="text-center max-w-xl mx-auto mb-8">
        <div class="text-[#8C5137] dark:text-[#D48D66] text-xs font-bold uppercase tracking-wider mb-2 flex items-center justify-center gap-1.5">
          <i class="fa-solid fa-file-pen"></i> Membership Application
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-[#4A2B1D] dark:text-white">
          Apply to Vintage Club
        </h1>
        <p class="text-[#8C5137] dark:text-slate-300 text-xs sm:text-sm mt-2">
          To join our brotherhood on the roads, please fill out the form below. Your application will be sent directly to the Vintage Club leadership via Discord.
        </p>
      </div>

      <form id="driver-apply-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">Full Name *</label>
            <input type="text" name="fullName" required placeholder="Your full name" class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">Age *</label>
            <input type="number" name="age" min="15" max="70" required placeholder="e.g. 22" class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">Discord Username *</label>
            <input type="text" name="discordTag" required placeholder="username or user#0000" class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">TruckersMP Profile Link *</label>
            <input type="url" name="truckersMpProfile" required placeholder="https://truckersmp.com/user/..." class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">Steam Profile Link</label>
            <input type="url" name="steamProfile" placeholder="https://steamcommunity.com/id/..." class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">ETS2 Playtime Hours</label>
            <input type="text" name="experienceHours" placeholder="e.g. 350+ Hours" class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors" />
          </div>
        </div>

        <!-- Custom Checkbox Grid for DLCs -->
        <div>
          <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-2">Owned Map DLCs</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="Scandinavia" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>Scandinavia</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="Going East" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>Going East</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="France" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>France</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="Italia" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>Italia</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="Baltic" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>Baltic</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="Black Sea" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>Black Sea</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="Iberia" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>Iberia</span>
            </label>
            <label class="custom-checkbox-btn">
              <input type="checkbox" name="dlcList" value="West Balkans" />
              <div class="check-icon-box"><i class="fa-solid fa-check"></i></div>
              <span>West Balkans</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#4A2B1D] dark:text-slate-300 mb-1.5">Additional Notes</label>
          <textarea name="notes" rows="3" placeholder="Any additional details or introduction you would like to share..." class="w-full px-3.5 py-2.5 bg-white dark:bg-[#13161D] border border-[#E1E2E4] dark:border-[#262A36] rounded-xl text-[#4A2B1D] dark:text-white placeholder-[#8C5137]/60 dark:placeholder-slate-500 focus:outline-none focus:border-[#8C5137] dark:focus:border-[#D48D66] text-xs sm:text-sm transition-colors"></textarea>
        </div>

        <button type="submit" class="w-full py-3 btn-primary text-xs sm:text-sm font-semibold rounded-lg gap-2">
          <i class="fa-solid fa-paper-plane text-xs"></i> Submit Application
        </button>
      </form>

      <div id="apply-form-feedback" class="hidden"></div>
    </div>
  </main>

  <!-- FOOTER PARTIAL -->
  <%- include('partials/footer') %>

  <!-- SCRIPTS PARTIAL -->
  <%- include('partials/scripts') %>

</body>
</html>
